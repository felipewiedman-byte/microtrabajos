<%- include('../partials/head') %>
<%
  const live = rows.filter((a) => a.status !== 'cancelled');
  const nToday = live.filter((a) => a.day === today).length, nPending = rows.filter((a) => a.status === 'pending').length;
  const perDay = {}; live.forEach((a) => { perDay[a.day] = (perDay[a.day] || 0) + 1; });
  const dur = (a) => { const d = a.end_min - a.start_min; return d >= 60 ? (d / 60).toString().replace('.', ',') + ' h' : d + ' min'; };
%>
<div class="page-h"><h1>Agenda</h1>
  <div class="row segs"><a class="btn btn-sm <%= past ? '' : 'btn-d' %>" href="/panel/agenda">Próximas</a><a class="btn btn-sm <%= past ? 'btn-d' : '' %>" href="/panel/agenda?ver=pasadas">Pasadas</a><a class="btn btn-sm" href="#bloqueos">Bloquear días</a></div></div>
<% if (!shop.agenda_on) { %><div class="flash error">La agenda está apagada: los clientes no pueden reservar. Actívala en <a href="/panel/negocio#agenda"><b>Mi negocio</b></a>.</div><% } %>
<% if (!past && rows.length) { %><div class="stats s3 ag-stats">
  <div class="stat"><small>Hoy</small><b><%= nToday %></b></div>
  <div class="stat<%= nPending ? ' ag-warn' : '' %>"><small>Por confirmar</small><b><%= nPending %></b></div>
  <div class="stat"><small>Próximas</small><b><%= live.length %></b></div>
</div><% } %>
<% if (!rows.length) { %><div class="card empty"><%- icon('calendar', 34) %><h3><%= past ? 'No hay citas pasadas' : 'No tienes citas próximas' %></h3><p class="small">Cuando tus clientes agenden desde tu catálogo con el botón <b>“Agendar cita”</b>, las citas aparecerán aquí.</p></div><% } %>
<% let lastDay = ''; rows.forEach((a) => { const st = { pending: ['Por confirmar', 'warn'], confirmed: ['Confirmada', 'ok'], done: ['Atendida', ''], cancelled: ['Cancelada', 'bad'] }[a.status] || ['', ''];
   const nm = a.customer_name.split(' ')[0], when = A.fmtDay(a.day) + ' a las ' + A.label(a.start_min);
   const msg = a.status === 'cancelled' ? `Hola ${nm}, te escribimos de ${shop.name} por tu reserva ${a.code}.` : a.status === 'pending' ? `¡Hola ${nm}! ✅ Tu cita de ${a.service} en ${shop.name} quedó confirmada para el ${when}. Te esperamos.` : `Hola ${nm} 👋 Te recordamos tu cita de ${a.service} en ${shop.name} el ${when}.`; %>
  <% if (a.day !== lastDay) { lastDay = a.day; const n = perDay[a.day] || 0; %><h3 class="sec-h ag-day"><span><%= a.day === today ? 'Hoy · ' : a.day === tomorrow ? 'Mañana · ' : '' %><%= A.fmtDay(a.day) %></span><span class="ag-n"><%= n === 1 ? '1 cita' : n + ' citas' %></span></h3><% } %>
  <article class="ag ag-<%= a.status %>">
    <div class="ag-time"><b><%= A.label(a.start_min) %></b><small>a <%= A.label(a.end_min) %></small><em><%= dur(a) %></em></div>
    <div class="ag-body">
      <div class="ag-head"><b class="ag-svc"><%= a.service %></b><span class="badge <%= st[1] %>"><%= st[0] %></span></div>
      <div class="ag-who"><span class="ag-av" aria-hidden="true"><%= a.customer_name.trim().charAt(0).toUpperCase() %></span><span><b><%= a.customer_name %></b><small><%= a.customer_phone || 'Sin teléfono' %> · <%= a.code %></small></span></div>
      <% if (a.note) { %><div class="ag-note">📝 <%= a.note %></div><% } %>
      <div class="ag-acts">
        <% if (a.customer_phone) { %><a class="btn btn-sm btn-wa" target="_blank" rel="noopener" href="<%= S.waLink(a.customer_phone, msg) %>"><%- icon('chat', 15) %> <%= a.status === 'pending' ? 'Confirmar por WhatsApp' : 'Escribir' %></a><% } %>
        <form method="post" action="/panel/agenda/<%= a.id %>" class="row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/panel/agenda<%= past ? '?ver=pasadas' : '' %>">
          <% if (a.status === 'pending') { %><button class="btn btn-sm btn-p" name="estado" value="confirmed">Marcar confirmada</button><% } %>
          <% if (a.status === 'confirmed') { %><button class="btn btn-sm btn-p" name="estado" value="done">Atendida</button><% } %>
          <% if (a.status !== 'cancelled' && a.status !== 'done') { %><button class="btn btn-sm btn-danger" name="estado" value="cancelled" data-confirm="¿Cancelar esta cita? El horario queda libre.">Cancelar</button><% } %>
          <% if (a.status === 'cancelled') { %><button class="btn btn-sm" name="estado" value="pending">Reactivar</button><% } %>
        </form>
      </div>
    </div>
  </article>
<% }) %>
<div class="card ag-blocks" id="bloqueos"><h3>Bloquear días u horas</h3>
  <p class="small muted mb">Vacaciones, festivos o un día en que no atiendes: tus clientes ya no verán esos horarios. Las citas que ya tengas no se cancelan solas.</p>
  <% if (blocks.length) { %><ul class="ag-bl"><% blocks.forEach((b) => { %><li>
    <span class="ag-bl-t"><b><%= A.fmtDay(b.day_from) %><%= b.day_to !== b.day_from ? ' → ' + A.fmtDay(b.day_to) : '' %></b><small><%= b.start_min === null ? 'Todo el día' : 'De ' + A.label(b.start_min) + ' a ' + A.label(b.end_min) %><%= b.reason ? ' · ' + b.reason : '' %></small></span>
    <form method="post" action="/panel/agenda/bloqueos/<%= b.id %>/borrar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger" data-confirm="¿Quitar este bloqueo? Esos horarios vuelven a estar disponibles.">Quitar</button></form></li><% }) %></ul><% } %>
  <form method="post" action="/panel/agenda/bloqueos" class="ag-blf"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="two"><div class="field"><label for="bf">Desde</label><input id="bf" type="date" name="from" min="<%= today %>" required></div><div class="field"><label for="bt">Hasta <span class="muted">(opcional)</span></label><input id="bt" type="date" name="to" min="<%= today %>"></div></div>
    <div class="field"><label class="chk"><input type="radio" name="scope" value="day" checked> Todo el día</label> <label class="chk"><input type="radio" name="scope" value="hours"> Solo unas horas</label></div>
    <div class="two"><div class="field"><label for="bhs">De</label><input id="bhs" type="time" name="hs"></div><div class="field"><label for="bhe">A</label><input id="bhe" type="time" name="he"></div></div>
    <div class="field"><label for="br">Motivo <span class="muted">(solo lo ves tú)</span></label><input id="br" name="reason" maxlength="80" placeholder="Ej.: Vacaciones"></div>
    <button class="btn btn-p">Bloquear</button>
  </form></div>
<%- include('../partials/foot') %>
