<%- include('../partials/head') %>
<div class="wrap narrow auth"><div class="card">
  <% if (!valid) { %><h1>Enlace vencido</h1><p class="sub">Este enlace ya no es válido. Pide uno nuevo.</p><a class="btn btn-p btn-block" href="/recuperar">Pedir otro enlace</a>
  <% } else { %><h1>Nueva contraseña</h1><p class="sub">Elige una contraseña de al menos 8 caracteres.</p>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/restablecer/<%= token %>"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="p">Nueva contraseña</label><input id="p" type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"></div>
    <button class="btn btn-p btn-block btn-lg">Guardar contraseña</button>
  </form><% } %>
</div></div>
<%- include('../partials/foot') %>
