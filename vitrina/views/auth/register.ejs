<%- include('../partials/head') %>
<div class="au"><%- include('../partials/authside') %><div class="au-main"><div class="au-card"><%- include('../partials/logo', { variant: 'light', cls: 'au-logo' }) %>
  <h1><%= TX('reg_title') %></h1><p class="sub"><%= TX('reg_sub') %></p>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/registro" autocomplete="on"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="field"><label for="n">Tu nombre</label><input id="n" name="name" value="<%= form.name || '' %>" required maxlength="60" autocomplete="name"></div>
    <div class="field"><label for="e">Correo</label><input id="e" type="email" name="email" value="<%= form.email || '' %>" required maxlength="120" autocomplete="email"></div>
    <div class="field"><label for="p">Contraseña</label><input id="p" type="password" name="password" required minlength="8" maxlength="72" autocomplete="new-password"><div class="hint">Mínimo 8 caracteres.</div></div>
    <label class="check"><input type="checkbox" name="terms" value="1" required> <span class="small">Acepto los <a href="/terminos" target="_blank">términos</a> y la <a href="/privacidad" target="_blank">política de privacidad</a>.</span></label>
    <button class="btn btn-p btn-block btn-lg mt"><%= TX('reg_btn') %></button>
  </form>
  <p class="center small muted mt2">¿Ya tienes cuenta? <a href="/ingresar"><b>Ingresar</b></a></p>
</div></div></div>
<%- include('../partials/foot') %>
