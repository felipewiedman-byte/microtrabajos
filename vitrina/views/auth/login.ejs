<%- include('../partials/head') %>
<div class="au"><%- include('../partials/authside') %><div class="au-main"><div class="au-card"><%- include('../partials/logo', { variant: 'light', cls: 'au-logo' }) %>
  <h1><%= TX('login_title') %></h1><p class="sub"><%= TX('login_sub') %></p>
  <% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>
  <% if (error) { %><div class="flash error"><%= error %></div><% } %>
  <form method="post" action="/ingresar"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? next : '/panel' %>">
    <div class="field"><label for="e">Correo</label><input id="e" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email"></div>
    <div class="field"><label for="p">Contraseña</label><input id="p" type="password" name="password" required autocomplete="current-password"></div>
    <button class="btn btn-p btn-block btn-lg"><%= TX('login_btn') %></button>
  </form>
  <p class="center small mt2"><a href="/recuperar">¿Olvidaste tu contraseña?</a></p>
  <p class="center small muted mt">¿No tienes cuenta? <a href="/registro"><b>Crear mi catálogo</b></a></p>
</div></div></div>
<%- include('../partials/foot') %>
