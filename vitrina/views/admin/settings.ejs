<%- include('../partials/head') %>
<div class="page-h"><h1>Ajustes</h1></div>
<form method="post" action="/admin/ajustes"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card"><h3>Contacto y registro</h3>
  <div class="two">
    <div class="field"><label for="cw">Tu WhatsApp de ventas</label><input id="cw" name="contact_whatsapp" value="<%= settings.contact_whatsapp %>" inputmode="numeric"><div class="hint">Los botones de “contactar” escriben a este número.</div></div>
    <div class="field"><label for="se">Correo de soporte</label><input id="se" name="support_email" value="<%= settings.support_email %>"></div>
  </div>
  <label class="switch"><span>Permitir registros nuevos</span><input type="checkbox" name="signups_open" value="1" <%= settings.signups_open === '1' ? 'checked' : '' %>></label>
</div>
<p class="small muted mb">Nombre, color y logos: <a href="/admin/marca"><b>Marca</b></a> · Precios, productos y prueba gratis: <a href="/admin/planes"><b>Planes</b></a> · Textos y secciones: <a href="/admin/paginas"><b>Páginas</b></a> · Claves de cobro: <a href="/admin/pagos"><b>Pagos</b></a></p>
<button class="btn btn-p btn-lg">Guardar ajustes</button>
</form>
<%- include('../partials/foot') %>
