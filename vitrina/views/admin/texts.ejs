<%- include('../partials/head') %>
<%- include('_tabs') %>
<div class="page-h"><h1>Textos del sistema</h1><a class="btn" href="/registro" target="_blank" rel="noopener"><%- icon('eye', 16) %> Ver registro</a></div>
<p class="small muted mb">Aquí cambias los textos que no están en las páginas: ingreso y registro, el catálogo que ve el cliente, el mensaje que llega al WhatsApp del negocio, los correos y los errores. Si dejas un campo vacío vuelve al texto original. Variables disponibles: <b>{sitio}</b>, <b>{dias}</b> (días de prueba), <b>{desde}</b> y <b>{moneda}</b>.</p>
<form method="post" action="/admin/textos"><input type="hidden" name="_csrf" value="<%= csrf %>">
<% let grp = ''; LIST.forEach((x) => { const [g, k, label, def, kind, hint] = x; if (g !== grp) { if (grp) { %></div><% } grp = g; %><div class="card"><h3><%= g %></h3><% } %>
  <div class="field"><label for="t_<%= k %>"><%= label %></label>
  <% if (kind === 'text') { %><input id="t_<%= k %>" name="tx_<%= k %>" value="<%= saved[k] %>" placeholder="<%= def %>" maxlength="300">
  <% } else { %><textarea id="t_<%= k %>" name="tx_<%= k %>" rows="<%= k === 'order_msg' ? 11 : (kind === 'lines' ? 4 : 3) %>" placeholder="<%= def %>"><%= saved[k] %></textarea><% } %>
  <% if (hint) { %><div class="hint"><%= hint %></div><% } %>
  <% if (saved[k]) { %><label class="check mt"><input type="checkbox" name="reset_<%= k %>" value="1"> Volver al texto original</label><% } %></div>
<% }) %></div>
<button class="btn btn-p btn-lg">Guardar textos</button>
</form>
<%- include('../partials/foot') %>
