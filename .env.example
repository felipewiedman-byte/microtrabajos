# Copie este archivo como .env y complete los valores.
PORT=3000
NODE_ENV=production
BASE_URL=https://www.su-dominio.com
SESSION_SECRET=cambie-por-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=admin@su-dominio.com
ADMIN_PASSWORD=una-contraseña-segura
# Carpeta para base de datos y archivos (en Render/Railway, un disco persistente)
DATA_DIR=./data
# 0 = no crear datos de demostración
SEED_DEMO=0

# Mercado Pago (Tus integraciones > Credenciales). Use credenciales de prueba primero.
MP_ACCESS_TOKEN=
MP_CURRENCY=COP
MP_SANDBOX=0

# PayPal (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Pagos simulados: 1 = siempre, 0 = nunca. Vacío = solo si no hay pasarelas configuradas.
DEMO_PAYMENTS=0

# --- Ciudades de todo el mundo (búsqueda y GPS) ---
# Por defecto usa OpenStreetMap Nominatim (gratis, 1 consulta/s, con caché local).
# Si el tráfico crece, use un servicio compatible (LocationIQ, Nominatim propio) cambiando estas variables.
# GEO_URL=https://nominatim.openstreetmap.org
# GEO_KEY=
# GEO_EMAIL=contacto@su-dominio.com
# GEO_LANG=es,en

# --- Producción (obligatorio) ---
# NODE_ENV=production  → la app NO arranca sin SESSION_SECRET (32+ caracteres), ADMIN_EMAIL y ADMIN_PASSWORD (10+).
# En producción el pago de prueba solo se activa si el administrador elige "Siempre" en Pagos.
