<%- include('../partials/head') %>
<%- include('_tabs') %>
<div class="page-h"><h1>Planes</h1></div>
<p class="small muted mb">Aquí cambias todo de cada plan: nombre, precio, cuántos productos, espacio, qué incluye y los textos de las tarjetas que ve el público. Lo que cambies se refleja al instante en la página de inicio y en el panel de tus clientes.</p>
<form method="post" action="/admin/planes"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card"><h3>General</h3>
  <div class="two"><div class="field"><label for="pc">Moneda de los precios (3 letras)</label><input id="pc" name="price_currency" value="<%= Plans.currency() %>" maxlength="3" style="text-transform:uppercase"><div class="hint">Debe ser una moneda que acepte tu cuenta de Mercado Pago / PayPal (ej.: USD, COP, MXN).</div></div></div>
  <div class="field"><label for="pcm">Incluido en todos los planes (uno por línea)</label><textarea id="pcm" name="plans_common" rows="4"><%= settings.plans_common %></textarea></div>
</div>
<% Plans.list().forEach((p) => { const k = p.key; %>
<div class="card"><div class="row between"><h3 style="margin:0"><%= k === 'trial' ? 'Prueba gratis' : 'Plan ' + p.name %></h3><label class="check" style="margin:0"><input type="checkbox" name="<%= k %>_active" value="1" <%= p.active ? 'checked' : '' %>> Visible y disponible</label></div>
  <div class="two mt">
    <div class="field"><label>Nombre</label><input name="<%= k %>_name" value="<%= p.name %>" maxlength="40" required></div>
    <div class="field"><label>Frase corta</label><input name="<%= k %>_descr" value="<%= p.descr %>" maxlength="120"></div>
  </div>
  <div class="three">
    <% if (k === 'trial') { %><div class="field"><label>Días de prueba</label><input name="<%= k %>_days" value="<%= p.days %>" inputmode="numeric"><div class="hint">0 = sin prueba: las cuentas nuevas quedan en pausa hasta que asignes o paguen un plan.</div></div>
    <% } else { %><div class="field"><label>Precio por mes (<%= Plans.currency() %>)</label><input name="<%= k %>_price" value="<%= p.price %>" inputmode="decimal"></div><% } %>
    <div class="field"><label>Máximo de productos</label><input name="<%= k %>_limit" value="<%= p.product_limit %>" inputmode="numeric"></div>
    <div class="field"><label>Espacio de imágenes (MB)</label><input name="<%= k %>_quota" value="<%= p.quota_mb %>" inputmode="decimal"></div>
  </div>
  <% if (k !== 'trial') { %><div class="two">
    <div class="field"><label>Descuento por pagar 3 meses (%)</label><input name="<%= k %>_disc3" value="<%= p.disc3 %>" inputmode="decimal"></div>
    <div class="field"><label>Descuento por pagar 12 meses (%)</label><input name="<%= k %>_disc12" value="<%= p.disc12 %>" inputmode="decimal"></div>
  </div><% } %>
  <div class="lbl mt">¿Qué incluye?</div>
  <div class="two"><% Object.entries(Plans.FEATURES).forEach(([f, label]) => { %><label class="switch"><span><%= label %></span><input type="checkbox" name="<%= k %>_f_<%= f %>" value="1" <%= p.features[f] ? 'checked' : '' %>></label><% }) %></div>
  <div class="hint">“Cobro en línea con Mercado Pago” solo se muestra si lo activas en Admin → Pagos.</div>
  <div class="two mt">
    <div class="field"><label>Líneas extra con ✓ (una por línea)</label><textarea name="<%= k %>_extra" rows="3"><%= p.extra %></textarea></div>
    <div><div class="field"><label>Texto del botón</label><input name="<%= k %>_cta" value="<%= p.cta %>" maxlength="40"></div><label class="switch"><span>Destacar como “Más elegido”</span><input type="checkbox" name="<%= k %>_hot" value="1" <%= p.hot ? 'checked' : '' %>></label></div>
  </div>
</div>
<% }) %>
<button class="btn btn-p btn-lg">Guardar planes</button>
</form>
<%- include('../partials/foot') %>
