<%- include("../partials/head") %>
<div class="container"><div class="page-head"><h1><%= title %></h1></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">
<div class="card"><h3>Denuncias abiertas</h3>
<% if (!reports.length) { %><p class="muted small">Sin denuncias.</p><% } %>
<% reports.forEach(function(r){ const link = { task: '/tareas/', gig: '/servicios/', user: '/perfil/', order: '/pedidos/' }[r.target_type] + r.target_id; %>
  <div class="list-row"><div><span class="badge"><%= r.target_type %></span> <a href="<%= link %>"><u><%= link %></u></a><br><span class="small"><%= r.reason %></span><br><span class="muted small">Por <%= r.name %> · <%= ago(r.created_at) %></span></div>
  <form method="post" action="/admin/reportes/<%= r.id %>/cerrar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm">Cerrar</button></form></div>
<% }) %></div>
<h2>Tareas</h2>
<div class="table-wrap"><table><thead><tr><th>Tarea</th><th>Cliente</th><th>Categoría</th><th>Presupuesto</th><th>Estado</th><th></th></tr></thead><tbody>
<% tasks.forEach(function(t){ %><tr><td><a href="/tareas/<%= t.id %>"><%= t.title %></a></td><td><%= t.client_name %></td><td class="small"><%= t.cat_name %></td><td><%= money(t.budget_cents) %></td><td><%- badge(t.status) %></td>
<td><% if (t.status !== 'removed') { %><form method="post" action="/admin/tareas/<%= t.id %>/eliminar" data-confirm="¿Eliminar esta tarea?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Eliminar</button></form><% } %></td></tr><% }) %>
</tbody></table></div>
<h2>Servicios</h2>
<div class="table-wrap"><table><thead><tr><th>Servicio</th><th>Trabajador</th><th>Precio</th><th>Estado</th><th></th></tr></thead><tbody>
<% gigs.forEach(function(g){ %><tr><td><a href="/servicios/<%= g.id %>"><%= g.title %></a></td><td><%= g.worker_name %></td><td><%= money(g.price_cents) %></td><td><%- badge(g.status) %></td>
<td><% if (g.status !== 'removed') { %><form method="post" action="/admin/servicios/<%= g.id %>/eliminar" data-confirm="¿Eliminar este servicio?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Eliminar</button></form><% } %></td></tr><% }) %>
</tbody></table></div>
</div></div></div>
<%- include("../partials/foot") %>
