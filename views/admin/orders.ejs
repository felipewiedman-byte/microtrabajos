<%- include("../partials/head") %>
<div class="container"><div class="page-head"><h1><%= title %></h1></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">
<div class="table-wrap"><table><thead><tr><th>#</th><th>Trabajo</th><th>Cliente</th><th>Trabajador</th><th>Importe</th><th>Tarifa</th><th>Comisión</th><th>Estado</th><th>Creado</th></tr></thead><tbody>
<% orders.forEach(function(o){ %><tr><td><%= o.id %></td><td><a href="/pedidos/<%= o.id %>"><%= o.title %></a></td><td><%= o.client_name %></td><td><%= o.worker_name %></td><td><%= money(o.amount_cents) %></td><td><%= money(o.client_fee_cents) %></td><td><%= money(o.commission_cents) %></td><td><%- badge(o.status) %></td><td class="small muted"><%= date(o.created_at) %></td></tr><% }) %>
</tbody></table></div>
</div></div></div>
<%- include("../partials/foot") %>
