<%- include("../partials/head") %>
<div class="container"><div class="page-head"><h1><%= title %></h1></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">

<div class="row"><% [7,30,90].forEach(function(d){ %><a class="btn btn-sm <%= days===d?'btn-primary':'' %>" href="?dias=<%= d %>">Últimos <%= d %> días</a><% }) %></div>
<div class="grid g4">
  <div class="kpi dark"><span>Ingresos de la plataforma</span><strong><%= money(tot.revenue) %></strong></div>
  <div class="kpi"><span>Volumen pagado (GMV)</span><strong><%= money(tot.gmv) %></strong></div>
  <div class="kpi"><span>Registros nuevos</span><strong><%= tot.signups %> <small class="muted">/ <%= tot.users %> total</small></strong></div>
  <div class="kpi"><span>Usuarios activos (ingresaron)</span><strong><%= tot.active %></strong></div>
  <div class="kpi"><span>Clientes que pagaron</span><strong><%= tot.clients %></strong></div>
  <div class="kpi"><span>Trabajadores contratados</span><strong><%= tot.workers %></strong></div>
  <div class="kpi"><span>Tareas publicadas · contratadas</span><strong><%= tot.tasks %> · <%= tot.hired %></strong></div>
  <div class="kpi"><span>Tasa de contratación</span><strong><%= tot.tasks ? Math.round(tot.hired / tot.tasks * 100) : 0 %>%</strong></div>
</div>
<% [['signups','Registros por día'],['logins','Usuarios activos por día'],['tasks','Tareas publicadas por día'],['orders','Pedidos pagados por día'],['revenue','Ingresos de la plataforma por día (USD)']].forEach(function(g){ const data = m[g[0]], max = Math.max(1, ...data.map(d => d.v)), money_ = g[0]==='revenue'; %>
  <div class="card"><div class="card-head"><h3><%= g[1] %></h3><span class="muted small">Total: <%= money_ ? money(data.reduce((a,b)=>a+b.v,0)) : data.reduce((a,b)=>a+b.v,0) %></span></div>
    <div class="bars" style="grid-template-columns:repeat(<%= days %>,1fr)"><% data.forEach(function(d){ %><div style="height:<%= Math.max(1, d.v / max * 100) %>%" title="<%= d.label %>: <%= money_ ? money(d.v) : d.v %>"></div><% }) %></div>
    <div class="bars-labels" style="grid-template-columns:repeat(<%= days %>,1fr)"><% data.forEach(function(d, i){ %><span><%= (i % Math.ceil(days/10) === 0) ? d.label : '' %></span><% }) %></div>
  </div>
<% }) %>
<div class="grid g3">
  <div class="card"><div class="card-head"><h3>Usuarios por país</h3></div><% byCountry.forEach(function(c){ %><div class="list-row"><span><%= c.country %></span><strong><%= c.c %></strong></div><% }) %></div>
  <div class="card"><div class="card-head"><h3>Tareas por categoría</h3></div><% byCategory.forEach(function(c){ %><div class="list-row"><span class="small"><%= c.name %></span><strong><%= c.n %></strong></div><% }) %></div>
  <div class="card"><div class="card-head"><h3>Mejores trabajadores</h3></div><% if (!topWorkers.length) { %><p class="muted small">Sin datos en el período.</p><% } %><% topWorkers.forEach(function(w){ %><div class="list-row"><a href="/admin/usuarios/<%= w.id %>"><%= w.name %></a><span class="small"><%= w.n %> · <%= money(w.v) %></span></div><% }) %></div>
</div>

</div></div></div>
<%- include("../partials/foot") %>
