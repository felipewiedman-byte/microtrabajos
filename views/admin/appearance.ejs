<%- include("../partials/head") %>
<div class="container"><div class="page-head"><h1><%= title %></h1></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">

<form method="post" action="/admin/apariencia" enctype="multipart/form-data" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card"><div class="card-head"><h3>Identidad</h3></div>
  <div class="form-row">
    <div class="field"><label>Nombre del sitio</label><input type="text" name="site_name" value="<%= settings.site_name %>" maxlength="40"><div class="hint">Se usa en la pestaña del navegador y si no hay logo.</div></div>
    <div class="field"><label>Tipografía</label><select name="font"><% FONTS.forEach(function(f){ %><option <%= settings.font===f?'selected':'' %>><%= f %></option><% }) %></select></div>
  </div>
  <div class="grid g3">
    <% [['logo_color','Logo a color','PNG o JPG, máximo 3 MB. Para fondos claros.','#ffffff'],['logo_white','Logo blanco','PNG transparente, máximo 3 MB. Barra superior y pie de página.', settings.color_dark],['favicon','Ícono de pestaña (favicon)','Cuadrado, de 64 × 64 px o más. Formatos: PNG o ICO. Máximo 5 MB.','#ffffff']].forEach(function(l){ %>
      <div class="card" style="padding:12px">
        <label><%= l[1] %></label>
        <div style="background:<%= l[3] %>;border:1px solid var(--line);border-radius:6px;height:70px;display:grid;place-items:center;margin-bottom:8px">
          <% if (settings[l[0]]) { %><img src="/media/<%= settings[l[0]] %>" style="max-height:50px;max-width:90%"><% } else { %><span class="muted small">Sin imagen</span><% } %>
        </div>
        <input type="file" name="<%= l[0] %>" accept=".png,.jpg,.jpeg,.webp,.gif,.ico">
        <div class="hint"><%= l[2] %></div>
        <% if (settings[l[0]]) { %><label class="check small mt-s"><input type="checkbox" name="remove_<%= l[0] %>" value="1"> Quitar imagen</label><% } %>
      </div>
    <% }) %>
  </div>
</div>
<div class="card"><div class="card-head"><h3>Contacto y redes sociales</h3></div>
  <p class="muted small">Se muestran en la franja superior y en el pie de página. Deje vacío lo que no quiera mostrar. Las redes deben empezar por https://</p>
  <div class="grid g4">
    <div class="field"><label>Correo de contacto</label><input type="text" name="contact_email" value="<%= settings.contact_email || '' %>"></div>
    <div class="field"><label>Teléfono</label><input type="text" name="contact_phone" value="<%= settings.contact_phone || '' %>"></div>
    <div class="field"><label>Horario de atención</label><input type="text" name="contact_hours" value="<%= settings.contact_hours || '' %>"></div>
    <div class="field"><label>Ciudad / país</label><input type="text" name="contact_city" value="<%= settings.contact_city || '' %>"></div>
  </div>
  <div class="grid g3">
    <% [['social_facebook','Facebook'],['social_instagram','Instagram'],['social_x','X (Twitter)'],['social_tiktok','TikTok'],['social_linkedin','LinkedIn'],['social_youtube','YouTube']].forEach(function(s){ %>
      <div class="field"><label><%= s[1] %></label><input type="text" name="<%= s[0] %>" value="<%= settings[s[0]] || '' %>" placeholder="https://"></div>
    <% }) %>
  </div>
  <div class="row"><label class="check"><input type="checkbox" name="show_topbar" value="1" <%= String(settings.show_topbar) !== '0' ? 'checked' : '' %>> Mostrar franja superior de contacto</label><label class="check"><input type="checkbox" name="show_newsletter" value="1" <%= String(settings.show_newsletter) !== '0' ? 'checked' : '' %>> Mostrar boletín en el inicio</label></div>
</div>
<div class="card"><div class="card-head"><h3>Imagen de la portada</h3></div>
  <div class="grid g2">
    <div>
      <div style="background:<%= settings.color_hero %>;border-radius:6px;height:170px;display:grid;place-items:center;margin-bottom:8px">
        <% if (settings.hero_image) { %><img src="/media/<%= settings.hero_image %>" style="max-height:150px;max-width:90%"><% } else { %><span class="small" style="color:#fff;opacity:.8">Sin imagen: se muestran los 4 recuadros de categorías</span><% } %>
      </div>
    </div>
    <div>
      <label>Subir imagen</label><input type="file" name="hero_image" accept=".png,.jpg,.jpeg,.webp,.gif">
      <div class="hint">Recomendado: <strong>PNG con fondo transparente</strong>, de unos 900 × 700 px. Reemplaza los recuadros de la derecha en la portada.</div>
      <% if (settings.hero_image) { %><label class="check small mt-s"><input type="checkbox" name="remove_hero_image" value="1"> Quitar imagen y volver a los recuadros</label><% } %>
      <label class="check small mt-s"><input type="checkbox" name="hero_default" value="1" <%= String(settings.hero_default) !== '0' ? 'checked' : '' %>> Si no subo imagen, usar la ilustración del ejecutivo con portátil</label>
      <label class="check small mt-s"><input type="checkbox" name="show_hero_stat" value="1" <%= String(settings.show_hero_stat) !== '0' ? 'checked' : '' %>> Mostrar la tarjeta de “tareas abiertas” debajo</label>
    </div>
  </div>
</div>
<div class="card"><div class="card-head"><h3>Colores</h3></div>
  <div class="grid g3">
    <% [['color_brand','Color principal','Botones, enlaces, encabezados'],['color_hero','Fondo de portada','Portada y llamado final'],['color_accent','Color de acento','Botón destacado (Publicar)'],['color_success','Color de éxito','Trabajadores, aprobaciones'],['color_warning','Color de alerta','Express, avisos'],['color_dark','Color oscuro','Franja de cifras y pie de página']].forEach(function(c){ %>
      <div class="field"><label><%= c[1] %></label><div class="swatch"><input type="color" value="<%= settings[c[0]] %>" data-sync="next"><input type="text" name="<%= c[0] %>" value="<%= settings[c[0]] %>" pattern="#[0-9a-fA-F]{6}" data-sync="prev"></div><div class="hint"><%= c[2] %></div></div>
    <% }) %>
  </div>
  <label class="check small"><input type="checkbox" name="reset_colors" value="1"> Restablecer colores y tipografía originales</label>
</div>
<div class="card"><div class="card-head"><h3>Secciones visibles en la página de inicio</h3><a class="small" href="/admin/secciones">Crear secciones nuevas</a></div>
  <div class="grid g3">
    <% const N = { paths: 'Tres caminos (cliente, trabajador, Express)', categories: 'Categorías', tasks: 'Tareas disponibles', figures: 'Cifras', how: 'Cómo funciona', gigs: 'Servicios', plans: 'Planes de créditos', features: 'Funciones', payments: 'Medios de pago', cta: 'Llamado final' }; %>
    <% SHOW_KEYS.forEach(function(k){ %><label class="check"><input type="checkbox" name="show_<%= k %>" value="1" <%= String(settings['show_'+k]) !== '0' ? 'checked' : '' %>> <%= N[k] %></label><% }) %>
  </div>
</div>
<div class="row"><button class="btn btn-primary">Guardar apariencia</button><a class="btn" href="/" target="_blank">Ver sitio</a></div>
</form>

</div></div></div>
<%- include("../partials/foot") %>
