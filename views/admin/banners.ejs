<%- include("../partials/head") %>
<%
const form = function(sl, action, label, isNew) {
  const imgMode = !sl.image ? 'none' : sl.image === 'default' ? 'default' : sl.image.indexOf('icons:') === 0 ? 'icons' : 'upload';
%>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <label class="check"><input type="checkbox" name="active" value="1" <%= sl.active ? 'checked' : '' %>> Visible en el inicio</label>
  <div class="form-row"><div class="field"><label>Orden (1 = primero)</label><input type="number" name="sort" min="0" max="999" value="<%= sl.sort %>"></div>
    <div class="field"><label>Ícono de la etiqueta</label><select name="icon"><% ICONS.forEach(function(i){ %><option value="<%= i %>" <%= sl.icon === i ? 'selected' : '' %>><%= i %></option><% }) %></select></div></div>
  <div class="field"><label>Etiqueta pequeña (arriba del título)</label><input type="text" name="kicker" maxlength="60" value="<%= sl.kicker %>" placeholder="Ej.: Publicar es gratis"></div>
  <div class="field"><label>Título</label><input type="text" name="title" maxlength="100" required value="<%= sl.title %>"></div>
  <div class="field"><label>Texto</label><textarea name="body" maxlength="260" style="min-height:70px"><%= sl.body %></textarea><div class="hint">Puedes usar {{sitio}} y se reemplaza por el nombre de la web.</div></div>
  <div class="form-row"><div class="field"><label>Botón 1: texto</label><input type="text" name="btn1_text" maxlength="32" value="<%= sl.btn1_text %>"></div><div class="field"><label>Botón 1: enlace</label><input type="text" name="btn1_link" maxlength="200" value="<%= sl.btn1_link %>" placeholder="/tareas/nueva"></div></div>
  <div class="form-row"><div class="field"><label>Botón 2: texto (opcional)</label><input type="text" name="btn2_text" maxlength="32" value="<%= sl.btn2_text %>"></div><div class="field"><label>Botón 2: enlace</label><input type="text" name="btn2_link" maxlength="200" value="<%= sl.btn2_link %>" placeholder="/explorar"></div></div>
  <div class="form-row"><div class="field"><label>Color de fondo (inicio)</label><input type="color" name="g1" value="<%= sl.g1 %>" style="height:42px"></div><div class="field"><label>Color de fondo (final)</label><input type="color" name="g2" value="<%= sl.g2 %>" style="height:42px"></div></div>
  <div class="field"><label>Imagen</label>
    <select name="image_mode"><% if (!isNew) { %><option value="keep" selected>Dejar como está<%= imgMode === 'upload' ? ' (mi imagen)' : imgMode === 'default' ? ' (ilustración de la web)' : imgMode === 'icons' ? ' (iconos)' : ' (ninguna)' %></option><% } %><option value="none" <%= isNew ? 'selected' : '' %>>Sin imagen</option><option value="default">Ilustración de la web</option><option value="icons">Cuatro iconos</option></select>
    <% if (imgMode === 'upload') { %><div class="mt-s"><img src="/media/<%= sl.image %>" alt="" style="max-height:90px;border-radius:10px;border:1px solid var(--line)"></div><% } %>
    <input type="file" name="image" accept="image/png,image/jpeg,image/webp,image/gif" class="mt-s"><div class="hint"><strong>Tamaño recomendado: 1120 × 560 px</strong> (formato horizontal 2:1), PNG, JPG o WebP, hasta 3 MB. La imagen se ajusta sin deformarse. Si subes una, reemplaza a la opción de arriba.</div></div>
  <div class="row" style="gap:8px"><button class="btn btn-primary"><%= label %></button></div>
</form>
<% }; %>
<div class="container"><div class="page-head"><h1><%= title %></h1><p>Los banners que rotan en la portada. Agrega, ordena, cambia textos, botones, colores e imagen, o apaga los que no quieras.</p></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">
<% slides.forEach(function(sl){ %>
<details class="card" <%= slides.length <= 1 ? 'open' : '' %>>
  <summary class="row between"><span><strong><%= sl.title %></strong> <span class="muted small">· orden <%= sl.sort %><%= sl.active ? '' : ' · oculto' %></span></span></summary>
  <div class="mt"><% form(sl, '/admin/banners/' + sl.id, 'Guardar banner', false); %>
  <form method="post" action="/admin/banners/<%= sl.id %>/eliminar" class="mt-s" data-confirm="¿Eliminar este banner?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Eliminar banner</button></form></div>
</details>
<% }) %>
<% if (slides.length < MAX) { %>
<div class="card"><h3>Nuevo banner</h3><p class="muted small">Puedes tener hasta <%= MAX %>. Ahora hay <%= slides.length %>.</p>
  <% form({ sort: slides.length + 1, active: 1, icon: 'star', kicker: '', title: '', body: '', btn1_text: '', btn1_link: '', btn2_text: '', btn2_link: '', image: '', g1: '#312e81', g2: '#6d28d9' }, '/admin/banners/nuevo', 'Crear banner', true); %>
</div>
<% } else { %><div class="alert alert-info"><span>Ya tienes el máximo de <%= MAX %> banners. Elimina uno para agregar otro.</span></div><% } %>
<p class="muted small"><a href="/" target="_blank"><u>Ver cómo queda en el inicio</u></a></p>
</div></div></div>
<%- include("../partials/foot") %>
