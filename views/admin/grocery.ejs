<%- include("../partials/head") %>
<div class="container"><div class="page-head"><h1><%= title %></h1><p>Supermercados por ciudad, catálogo y precios. Los precios también se actualizan solos con cada recibo de compra.</p></div><div class="layout-left"><%- include("../partials/admin-side") %><div class="stack">
<form class="card" method="post" action="/admin/mercado/estado"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="row between"><div><strong>Estado del mercado: <%= String(settings.grocery_enabled) === '1' ? 'ACTIVO (visible para los usuarios)' : 'DESACTIVADO (oculto para todos)' %></strong><br><span class="muted small">Actívelo solo cuando tenga productos y precios reales cargados.</span></div>
  <% if (String(settings.grocery_enabled) === '1') { %><button class="btn btn-danger">Desactivar mercado</button><% } else { %><button class="btn btn-primary" name="enabled" value="1">Activar mercado</button><% } %></div>
</form>
<% if (sample) { %><div class="alert alert-warn"><span><strong><%= sample %> precios son de ejemplo</strong> (instalación de demostración). Reemplácelos con los precios reales antes de lanzar.</span><form method="post" action="/admin/mercado/ejemplo/borrar" data-confirm="¿Borrar todos los precios de ejemplo?" style="margin-left:auto"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-danger">Borrar precios de ejemplo</button></form></div><% } %>

<form class="card" method="post" action="/admin/mercado/cadenas"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <div class="card-head"><h3><%- icon('cart', 16) %> Supermercados y ciudades</h3></div>
  <div class="table-wrap"><table><thead><tr><th>Activo</th><th>Cadena</th><th>Ciudades donde opera (separadas por coma)</th></tr></thead><tbody>
  <% chains.forEach(function(c){ %><tr><td><input type="checkbox" name="active<%= c.id %>" value="1" <%= c.active ? 'checked' : '' %>></td><td><span class="gx-chip" style="--cc:<%= c.color %>"><%= c.name %></span><br><span class="muted small">código: <%= c.slug %></span></td><td><input type="text" name="cities<%= c.id %>" value="<%= c.cities %>"></td></tr><% }) %>
  </tbody></table></div>
  <div class="grid g3 mt"><input type="text" name="new_name" placeholder="Agregar cadena (ej.: Isimo)"><input type="text" name="new_cities" placeholder="Ciudades"><input type="text" name="new_color" placeholder="Color #e30613"></div>
  <button class="btn btn-primary mt">Guardar supermercados</button>
</form>

<div class="card"><div class="card-head"><h3>Importar precios en bloque (CSV)</h3><a class="small" href="/admin/mercado/plantilla.csv">Descargar plantilla con precios actuales</a></div>
  <p class="small muted">Descargue la plantilla, ábrala en Excel, escriba los precios en pesos en la columna de cada supermercado y súbala. Columnas: producto; unidad; categoría; y una columna por cadena (exito, olimpica, jumbo…). Celda vacía = sin cambio.</p>
  <form method="post" action="/admin/mercado/importar" enctype="multipart/form-data" class="row"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="file" name="csv" accept=".csv,.txt" required style="max-width:320px"><button class="btn btn-primary">Importar</button></form>
</div>

<form class="card" method="post" action="/admin/mercado/precios"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="q" value="<%= q %>">
  <div class="card-head"><h3>Precios por producto (COP)</h3><span class="muted small">Vacío = no disponible en esa cadena</span></div>
  <div class="row mb"><input type="search" form="gq" name="q" value="<%= q %>" placeholder="Filtrar producto" style="flex:1"><button class="btn" form="gq">Filtrar</button></div>
  <div class="table-wrap gx-admin"><table><thead><tr><th>Producto</th><% chains.forEach(function(c){ %><th><%= c.name %></th><% }) %></tr></thead><tbody>
    <% products.forEach(function(p){ %><tr><td><strong class="small"><%= p.name %></strong><br><span class="muted small"><%= p.category %></span></td>
      <% chains.forEach(function(c){ const x = (pmap[p.id] || {})[c.id]; %><td><input type="text" inputmode="numeric" name="pr_<%= p.id %>_<%= c.id %>" value="<%= x ? x.price : '' %>" title="<%= x ? 'Fuente: ' + x.source + ' · ' + date(x.updated_at) : '' %>" class="<%= x && x.source === 'recibo' ? 'gx-rec' : x && x.source === 'ejemplo' ? 'gx-ex' : '' %>"></td><% }) %></tr><% }) %>
  </tbody></table></div>
  <div class="grid g3 mt"><input type="text" name="new_product" placeholder="Nuevo producto (ej.: Leche deslactosada 1 L)"><input type="text" name="new_unit" placeholder="Unidad"><input type="text" name="new_category" placeholder="Categoría"></div>
  <div class="row mt"><button class="btn btn-primary">Guardar precios</button><span class="muted small">Azul: actualizado por recibo · Amarillo: ejemplo</span></div>
</form>
<form id="gq" action="/admin/mercado"></form>

<div class="card"><div class="card-head"><h3>Pedidos de mercado</h3></div>
  <div class="table-wrap"><table><thead><tr><th>#</th><th>Cliente</th><th>Cadena</th><th>Ciudad</th><th>Pagado</th><th>Recibo</th><th>Reembolso</th><th>Estado</th></tr></thead><tbody>
  <% if (!orders.length) { %><tr><td colspan="8" class="muted">Sin pedidos aún.</td></tr><% } %>
  <% orders.forEach(function(o){ %><tr><td><a href="/mercado/pedidos/<%= o.id %>"><%= o.id %></a></td><td><%= o.client_name %></td><td><%= o.chain_name %></td><td><%= o.city %></td><td>$<%= o.total.toLocaleString('es-CO') %></td><td><%= o.receipt_total != null ? '$' + o.receipt_total.toLocaleString('es-CO') : '—' %></td><td><%= o.refund ? '$' + o.refund.toLocaleString('es-CO') : '—' %></td><td><%- badge(o.status) %></td></tr><% }) %>
  </tbody></table></div>
  <p class="muted small mt-s">Los reembolsos (sobrantes y cancelaciones) aparecen en Finanzas como “Reembolso pendiente”: hágalos desde Mercado Pago o PayPal y márquelos allí.</p>
</div>
</div></div></div>
<%- include("../partials/foot") %>
