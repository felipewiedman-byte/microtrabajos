<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Mis trabajos</h1><p>Gestiona los trabajos que realizas y los que contrataste.</p></div>
  <div class="tabs"><a href="/pedidos" class="<%= tab==='trabajador'?'active':'' %>">Como trabajador</a><a href="/pedidos?rol=cliente" class="<%= tab==='cliente'?'active':'' %>">Como cliente</a></div>
  <% if (!orders.length) { %><div class="empty"><%= tab==='cliente' ? 'Aún no contrataste trabajos.' : 'Aún no tienes trabajos asignados.' %></div><% } else { %>
  <div class="table-wrap"><table><thead><tr><th>#</th><th>Trabajo</th><th><%= tab==='cliente' ? 'Trabajador' : 'Cliente' %></th><th>Importe</th><th>Vence</th><th>Estado</th></tr></thead><tbody>
    <% orders.forEach(function(o){ %><tr><td class="muted"><%= o.id %></td><td><a href="/pedidos/<%= o.id %>"><strong><%= o.title %></strong></a></td><td><%= tab==='cliente' ? o.worker_name : o.client_name %></td><td><%= money(o.amount_cents) %></td><td class="muted small"><%= o.due_at ? date(o.due_at) : '—' %></td><td><%- badge(o.status) %></td></tr><% }) %>
  </tbody></table></div><% } %>
</div>
<%- include('partials/foot') %>
