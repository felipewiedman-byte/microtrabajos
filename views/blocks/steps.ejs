<section class="sec <%= BL.bgClass(b.bg) %>"<% if (b.anchor) { %> id="<%= b.anchor %>"<% } %>><div class="wrap">
  <div class="lp-head"><% if (b.kicker) { %><span class="kick"><%= BL.tok(b.kicker) %></span><% } %><h2><%= BL.tok(b.title) %></h2><% if (b.sub) { %><p><%= BL.tok(b.sub) %></p><% } %></div>
  <div class="grid3 steps"><% BL.lines(b.items).forEach((l) => { const [t, x] = BL.cols(l, 2); %><div class="step"><h3><%= BL.tok(t) %></h3><p><%= BL.tok(x) %></p></div><% }) %></div>
</div></section>
