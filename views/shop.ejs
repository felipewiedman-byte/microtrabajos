<%- include('partials/head') %>
<% const zero = S.ZERO.has(shop.currency) ? 1 : 0; const dayNames = S.DAYS; const todayKey = null; %>
<div id="shop" data-slug="<%= shop.slug %>" data-tx="<%= JSON.stringify({ done_title: TX('shop_done_title'), done_msg: TX('shop_done_msg'), open_wa: TX('shop_open_wa') }) %>" data-cur="<%= shop.currency %>" data-locale="<%= S.localeOf(shop.currency) %>" data-zero="<%= zero %>" data-name="<%= shop.name %>"
  data-wa="<%= shop.whatsapp ? 1 : 0 %>" data-ms="<%= shop.messenger ? 1 : 0 %>" data-pickup="<%= shop.pickup_on ? 1 : 0 %>" data-delivery="<%= shop.delivery_on ? 1 : 0 %>"
  data-fee="<%= shop.delivery_fee_cents %>" data-min="<%= shop.min_order_cents %>" data-accepting="<%= shop.accepting ? 1 : 0 %>" data-focus="<%= focusId %>" data-pay="<%= payOn ? 1 : 0 %>" data-coupons="<%= S.can({ plan: shop.plan, plan_until: shop.plan_until, role: shop.owner_role }, 'coupons') ? 1 : 0 %>" data-px="<%= shop.fb_pixel %>" data-ga="<%= shop.ga_id %>">

<div class="cover" <% if (shop.cover) { %>style="background-image:url('/m/<%= shop.cover %>')"<% } %>></div>
<div class="sh-wrap">
  <header class="head">
    <% if (shop.logo) { %><img class="avatar" src="/m/<%= shop.logo %>" alt="" width="84" height="84"><% } else { %><div class="avatar" aria-hidden="true"><%= shop.name.trim().charAt(0).toUpperCase() %></div><% } %>
    <div style="padding-bottom:6px;min-width:0"><h1><%= shop.name %></h1><% if (shop.tagline) { %><div class="tg"><%= shop.tagline %></div><% } %></div>
  </header>

  <div class="meta">
    <% if (rv.n) { %><a class="chip chip-rv" href="#opiniones"><span class="st">★</span> <b><%= rv.avg.toFixed(1).replace('.', ',') %></b> <span class="muted">(<%= rv.n %>)</span></a><% } %>
    <% if (state.known) { %><span class="chip <%= state.open ? 'open' : 'closed' %>"><%- icon('clock', 15) %> <%= state.label %></span><% } %>
    <% if (shop.city || shop.address) { %><span class="chip"><%- icon('pin', 15) %> <%= shop.city || shop.address %></span><% } %>
    <% if (shop.delivery_on) { %><span class="chip"><%- icon('truck', 15) %> Domicilio</span><% } %>
    <% if (shop.whatsapp) { %><a class="chip chip-wa" href="<%= S.waLink(shop.whatsapp, TX('shop_ask_msg', { negocio: shop.name })) %>" target="_blank" rel="noopener"><%- icon('chat', 15) %> <%= TX('shop_ask') %></a><% } %>
    <button type="button" class="chip" id="infoBtn" aria-expanded="false" aria-controls="info"><%= TX('shop_more') %></button>
    <button type="button" class="chip" id="shareBtn" data-url="<%= og.url.split('?')[0] %>" data-title="<%= shop.name %>"><%- icon('share', 15) %> <%= TX('shop_share') %></button>
  </div>
  <% if (shop.description) { %><p class="about"><%= shop.description %></p><% } %>
  <% if (!shop.accepting) { %><div class="paused"><%= TX('shop_paused') %></div>
  <% } else if (state.known && !state.open) { %><div class="paused"><%= TX('shop_closed') %></div><% } %>

  <div class="info" id="info">
    <dl>
      <% if (Object.keys(hours).length) { %><dt>Horario</dt><dd>
        <% dayNames.forEach((d) => { %><div><%= d[1] %>: <%= hours[d[0]] ? S.fmtTime(hours[d[0]][0]) + ' – ' + S.fmtTime(hours[d[0]][1]) : 'Cerrado' %></div><% }) %></dd><% } %>
      <% if (shop.address) { %><dt>Dirección</dt><dd><%= shop.address %><%= shop.city ? ', ' + shop.city : '' %> · <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(shop.address + ' ' + shop.city) %>" target="_blank" rel="noopener">Cómo llegar</a></dd><% } %>
      <% if (shop.payment_info) { %><dt>Pagos</dt><dd style="white-space:pre-line"><%= shop.payment_info %></dd><% } %>
      <% if (shop.delivery_on) { %><dt>Domicilio</dt><dd><% if (zones.length) { %><% zones.forEach((z) => { %><div><%= z.n %>: <%= z.p ? S.money(z.p, shop.currency) : 'Gratis' %></div><% }) %><% } else { %><%= shop.delivery_fee_cents ? S.money(shop.delivery_fee_cents, shop.currency) : 'Gratis' %><% } %></dd><% } %>
      <% if (shop.min_order_cents) { %><dt>Pedido mínimo</dt><dd><%= S.money(shop.min_order_cents, shop.currency) %></dd><% } %>
      <% if (shop.instagram) { %><dt>Instagram</dt><dd><a href="https://instagram.com/<%= shop.instagram %>" target="_blank" rel="noopener">@<%= shop.instagram %></a></dd><% } %>
    </dl>
  </div>

  <% if (prods.length) { %>
  <div class="bar">
    <div class="search"><%- icon('search', 18) %><input type="search" id="q" placeholder="<%= TX('shop_search') %>" aria-label="Buscar" autocomplete="off"></div>
    <% if (cats.length) { %><div class="cats" id="cats"><button type="button" class="chip on" data-cat="">Todo</button><% cats.forEach((c) => { if (prods.some((p) => p.category_id === c.id)) { %><button type="button" class="chip" data-cat="<%= c.id %>"><%= c.name %></button><% } }) %></div><% } %>
  </div>

  <div id="catalog">
  <%
    const groups = [];
    cats.forEach((c) => { const l = prods.filter((p) => p.category_id === c.id); if (l.length) groups.push({ id: c.id, name: c.name, list: l }); });
    const loose = prods.filter((p) => !p.category_id || !cats.some((c) => c.id === p.category_id));
    if (loose.length) groups.push({ id: 0, name: groups.length ? 'Otros' : '', list: loose });
  %>
  <% groups.forEach((g) => { %>
    <section class="grp" data-cat="<%= g.id %>">
    <% if (g.name) { %><h2 class="sec-t"><%= g.name %></h2><% } else { %><div style="height:14px"></div><% } %>
    <div class="list<%= shop.layout === 'grid' ? ' grid' : '' %>">
    <% g.list.forEach((p) => { const out = p.stock !== null && p.stock <= 0; %>
      <article class="item<%= out ? ' out' : '' %>" id="p<%= p.id %>" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price_cents %>" data-stock="<%= p.stock === null ? '' : p.stock %>" data-search="<%= (p.name + ' ' + p.description).toLowerCase() %>"<% if (p.opts.length) { %> data-opts="<%= JSON.stringify(p.opts) %>"<% } %><% if (agendaOn && p.duration > 0) { %> data-dur="<%= p.duration %>"<% } %><% if (p.gal.length) { %> data-gal="<%= JSON.stringify([p.image, ...p.gal].filter(Boolean)) %>"<% } %>>
        <div class="tx">
          <% if (out) { %><span class="badge-s">Agotado</span><% } else if (p.featured) { %><span class="badge-s badge-f">Destacado</span><% } else if (p.stock !== null && p.stock <= 3) { %><span class="badge-s">¡Últimas <%= p.stock %>!</span><% } %>
          <h3><%= p.name %></h3>
          <% if (p.description) { %><p><%= p.description %></p><% } %>
          <% if (p.opts.length) { %><span class="optl"><%= p.opts.map((g) => g.name).join(' · ') %></span><% } %>
          <% if (agendaOn && p.duration > 0) { %><span class="optl"><%- icon('clock', 13) %> <%= p.duration >= 60 ? (p.duration / 60).toString().replace('.', ',') + ' h' : p.duration + ' min' %></span><% } %>
          <div class="pr"><b><%= S.money(p.price_cents, shop.currency) %></b><% if (p.compare_cents > p.price_cents) { %><s><%= S.money(p.compare_cents, shop.currency) %></s><% } %><% if (shop.whatsapp) { %><a class="shp shp-wa" href="<%= S.waLink(shop.whatsapp, TX('shop_ask_product', { producto: p.name, precio: S.money(p.price_cents, shop.currency) })) %>" target="_blank" rel="noopener" aria-label="Preguntar por <%= p.name %> en WhatsApp" title="Preguntar por WhatsApp"><%- icon('chat', 16) %></a><% } %><button type="button" class="shp" data-share="<%= p.id %>" aria-label="Compartir <%= p.name %>"><%- icon('share', 16) %></button></div>
        </div>
        <div class="ph">
          <% const im = p.image || p.gal[0]; %><% if (im) { %><span class="pic"><img src="/m/<%= im %>" alt="<%= p.name %>" width="112" height="112" loading="lazy" data-zoom="<%= p.id %>"><% if (p.gal.length) { %><span class="nimg"><%- icon('image', 12) %> <%= p.gal.length + (p.image ? 1 : 0) %></span><% } %></span><% } else { %><div class="no"><%- icon('image', 26) %></div><% } %>
          <% if (!out && shop.accepting) { %><div class="ctl"><button type="button" class="add" data-add="<%= p.id %>"><%- icon('plus', 16) %> <%= TX('shop_add') %></button></div><% } %>
        </div>
      </article>
    <% }) %>
    </div></section>
  <% }) %>
  </div>
  <% if (reviews.length) { %>
  <section class="rvs" id="opiniones"><h2 class="sec-t">Opiniones de clientes <span class="muted">· <span class="st">★</span> <%= rv.avg.toFixed(1).replace('.', ',') %> de 5 · <%= rv.n %> opinion<%= rv.n === 1 ? '' : 'es' %></span></h2>
    <div class="rv-list"><% reviews.forEach((r) => { %><article class="rv"><div class="rv-top"><b><%= r.name %></b><span class="st" aria-label="<%= r.stars %> de 5"><%= '★'.repeat(r.stars) %><span class="off"><%= '★'.repeat(5 - r.stars) %></span></span></div><% if (r.body) { %><p><%= r.body %></p><% } %><small><%= new Date(r.created_at).toLocaleDateString('es-CO', { timeZone: shop.tz, month: 'long', year: 'numeric' }) %></small></article><% }) %></div>
  </section>
  <% } %>
  <div class="none" id="none" hidden>No encontramos nada con esa búsqueda.</div>
  <% } else { %>
  <div class="none"><%- icon('bag', 34) %><p class="mt">Este catálogo aún no tiene productos.</p></div>
  <% } %>

  <% if (brand) { %><p class="powered">Hecho con <a href="/"><%= settings.site_name %></a> · <a href="/registro">Crea tu catálogo gratis</a></p><% } %>
</div>

<% if (shop.whatsapp) { %><a class="wafab" id="waFab" href="<%= S.waLink(shop.whatsapp, TX('shop_ask_msg', { negocio: shop.name })) %>" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp"><svg width="28" height="28" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z"/></svg></a><% } %>
<div class="cartbar" id="cartbar"><button type="button" id="openCart"><span><span class="n" id="cartN">0</span> <%= TX('shop_cart') %></span><b id="cartT"></b></button></div>
<div class="ov" id="ov"></div>
<div class="sheet" id="sheet" role="dialog" aria-modal="true" aria-label="Tu pedido">
  <h2><span id="sheetT">Tu pedido</span><button type="button" class="x" id="closeCart" aria-label="Cerrar"><%- icon('x', 18) %></button></h2>
  <div id="vCart">
    <p class="cempty" id="cartEmpty">Agrega productos con el botón <b>+ Agregar</b> y aquí verás tu pedido.</p>
    <div id="cartList"></div>
    <div class="sum" id="sum"></div>
    <div class="field" id="couponBox" hidden><label for="coupon">¿Tienes un cupón?</label><div class="row" style="flex-wrap:nowrap"><input id="coupon" placeholder="CÓDIGO" maxlength="30" autocapitalize="characters" style="text-transform:uppercase"><button type="button" class="btn" id="applyCoupon">Aplicar</button></div><div class="hint" id="couponMsg"></div></div>
    <% if (shop.pickup_on && shop.delivery_on) { %><div class="seg"><label><input type="radio" name="mode" value="pickup" checked> Recoger</label><label><input type="radio" name="mode" value="delivery"> Domicilio</label></div>
    <% } else if (shop.delivery_on) { %><input type="hidden" name="mode" value="delivery"><% } else { %><input type="hidden" name="mode" value="pickup"><% } %>
    <% if (shop.delivery_on && zones.length) { %><div class="field" id="zoneBox" hidden><label for="cZone">Zona de entrega</label><select id="cZone"><option value="">Elige tu barrio o sector</option><% zones.forEach((z, i) => { %><option value="<%= i %>" data-fee="<%= z.p %>"><%= z.n %> — <%= z.p ? S.money(z.p, shop.currency) : 'Gratis' %></option><% }) %></select></div><% } %>
    <div class="field"><label for="cName">Tu nombre</label><input id="cName" maxlength="60" autocomplete="name" required></div>
    <div class="field"><label for="cPhone">Tu teléfono <span class="muted">(para avisarte cómo va tu pedido)</span></label><input id="cPhone" type="tel" maxlength="20" autocomplete="tel"></div>
    <div class="field" id="addrBox" hidden><label for="cAddr">Dirección de entrega</label><input id="cAddr" maxlength="200" autocomplete="street-address"></div>
    <% if (methods.length) { %><div class="field"><span class="lbl">¿Cómo vas a pagar?</span><div class="seg pc"><% methods.forEach((m, i) => { %><label><input type="radio" name="pay" value="<%= i %>" <%= i === 0 ? 'checked' : '' %>> <%= m.label %></label><% }) %></div><div class="hint">Te enviamos los datos para pagar por el mismo chat.</div></div><% } %>
    <div class="field"><label for="cNote">Notas <span class="muted">(opcional)</span></label><input id="cNote" maxlength="300" placeholder="Ej.: sin cebolla, entregar a las 5"></div>
    <div class="err" id="err" hidden></div>
    <% if (payOn) { %><button type="button" class="btn btn-p btn-block btn-lg" id="payNow"><%- icon('card', 20) %> <%= TX('shop_pay_now') %></button><div class="hint center" style="margin:6px 0 12px">Tarjeta, PSE y más. Pago seguro con Mercado Pago.</div><% } %>
    <% if (shop.whatsapp) { %><button type="button" class="btn <%= payOn ? '' : 'btn-wa' %> btn-block btn-lg" id="sendWa"><%- icon('chat', 20) %> <%= payOn ? 'Pedir por WhatsApp' : TX('shop_send_wa') %></button><% if (payOn) { %><div class="hint center" style="margin-top:6px">Pagas al recibir o por transferencia, como acuerdes con el negocio.</div><% } %><% } %>
    <% if (shop.messenger) { %><button type="button" class="btn btn-block mt" id="sendMs"><%- icon('messenger', 20) %> <%= TX('shop_send_ms') %></button><% } %>
    <% if (!payOn) { %><p class="hint center mt"><%= TX('shop_nopay_hint') %></p><% } %>
  </div>
  <div id="vDone" class="okbox" hidden>
    <div class="tick"><%- icon('check', 32) %></div>
    <h3 id="doneTitle"></h3>
    <p class="mt" id="doneMsg">Se abrió tu chat para enviarlo. Si no se abrió, toca el botón.</p>
    <div class="pay" id="donePay" hidden></div>
    <a class="btn btn-wa btn-block btn-lg" id="doneLink" href="#" target="_blank" rel="noopener"><%= TX('shop_open_wa') %></a>
    <button type="button" class="btn btn-block mt" id="doneCopy" hidden>Copiar mensaje del pedido</button>
    <button type="button" class="btn btn-g btn-block mt" id="doneClose">Seguir viendo el catálogo</button>
  </div>
</div>
<div class="sheet" id="shareSheet" role="dialog" aria-modal="true" aria-label="Compartir">
  <h2><span id="shareT">Compartir</span><button type="button" class="x" id="closeShare" aria-label="Cerrar"><%- icon('x', 18) %></button></h2>
  <div class="shr" id="shr"></div>
</div>
<% if (agendaOn) { %><div class="sheet" id="bkSheet" role="dialog" aria-modal="true" aria-label="Reservar">
  <h2><span id="bkT">Reservar</span><button type="button" class="x" id="closeBk" aria-label="Cerrar"><%- icon('x', 18) %></button></h2>
  <div id="bkStep1"><p class="lbl">Elige el día</p><div class="bkdays" id="bkDays"></div><p class="lbl mt">Elige la hora</p><div class="bkslots" id="bkSlots"><p class="small muted">Primero elige un día.</p></div></div>
  <div id="bkStep2" hidden><div class="bksum" id="bkSum"></div>
    <div class="field"><label for="bkName">Tu nombre</label><input id="bkName" maxlength="60" autocomplete="name"></div>
    <div class="field"><label for="bkPhone">Tu WhatsApp</label><input id="bkPhone" type="tel" maxlength="20" autocomplete="tel" placeholder="Para confirmarte la cita"></div>
    <div class="field"><label for="bkNote">Nota <span class="muted">(opcional)</span></label><input id="bkNote" maxlength="300"></div>
    <div class="err" id="bkErr" hidden></div>
    <button type="button" class="btn btn-wa btn-block btn-lg" id="bkSend"><%- icon('chat', 20) %> Confirmar por WhatsApp</button>
    <button type="button" class="btn btn-g btn-block mt" id="bkBack">Cambiar día u hora</button></div>
</div><% } %>
<div class="sheet" id="optSheet" role="dialog" aria-modal="true" aria-label="Elegir opciones">
  <h2><span id="optT"></span><button type="button" class="x" id="closeOpt" aria-label="Cerrar"><%- icon('x', 18) %></button></h2>
  <img id="optImg" class="opthero" alt="" hidden><div id="optBody"></div>
  <div class="err" id="optErr" hidden></div>
  <div class="optfoot"><div class="qty" id="optQty"></div><button type="button" class="btn btn-p btn-lg" id="optAdd"></button></div>
</div>
<div class="zoom" id="zoom"><button type="button" class="zx" id="zoomX" aria-label="Cerrar">×</button><button type="button" class="zn zp" id="zoomP" aria-label="Anterior">‹</button><img alt=""><button type="button" class="zn zf" id="zoomN" aria-label="Siguiente">›</button><span class="zc" id="zoomC"></span></div>
</div>
<%- include('partials/foot') %>
