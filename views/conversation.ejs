<%- include('partials/head') %>
<div class="container">
  <div class="page-head">
    <span class="eyebrow">Conversación privada</span>
    <h1 class="mt-s"><%= publicName(other.name) %></h1>
    <p><%= other.headline || '' %><% if (gig) { %> · Sobre el servicio <a href="/servicios/<%= gig.id %>"><u><%= gig.title %></u></a><% } %><% if (task) { %> · Sobre la tarea <a href="/tareas/<%= task.id %>"><u><%= task.title %></u></a><% } %></p>
  </div>
  <div class="layout">
    <div class="card" id="chat">
      <div class="notice-bar">🔒 Chat protegido por MICROTRABAJO. Los correos, teléfonos y redes se ocultan automáticamente. Si pagan por fuera pierden la protección del pago, las calificaciones y pueden ser suspendidos.</div>
      <div class="chat-log">
        <% if (!msgs.length) { %><p class="muted small center">Aún no hay mensajes.</p><% } %>
        <% msgs.forEach(function(m){ const mine = m.user_id === user.id; %>
          <% if (m.order) { const o = m.order; %>
            <div class="offer">
              <span class="eyebrow">Oferta personalizada</span>
              <h3 class="mt-s"><%= o.title %></h3>
              <div class="row between"><span class="muted small">Entrega: <%= hours(o.delivery_hours) %></span><span class="price"><%= money(o.amount_cents) %></span></div>
              <div class="mt-s"><% if (o.status === 'pending_payment' && o.client_id === user.id && m.pay) { %><a class="btn btn-primary btn-block" href="/pagar/<%= m.pay.id %>">Aceptar y pagar <%= money(m.pay.amount_cents) %></a>
              <% } else if (o.status === 'pending_payment') { %><span class="badge warn">Esperando pago del cliente</span>
              <% } else { %><a class="btn btn-sm" href="/pedidos/<%= o.id %>">Ver pedido</a> <%- badge(o.status) %><% } %></div>
            </div>
          <% } else { %>
            <div class="msg <%= mine ? 'mine' : '' %>"><span class="who"><%= mine ? 'Tú' : publicName(m.name) %> · <%= ago(m.created_at) %></span><%= m.text %></div>
          <% } %>
        <% }) %>
      </div>
      <form method="post" action="/conversacion/<%= c.id %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <textarea name="text" placeholder="Escribe tu mensaje…" style="min-height:80px" required></textarea>
        <div class="row between"><span class="hint">No compartas datos de contacto.</span><button class="btn btn-primary btn-sm">Enviar</button></div>
      </form>
    </div>
    <aside class="stack sticky">
      <% if (gig ? gig.worker_id === user.id : task ? task.client_id !== user.id : true) { %>
      <div class="card tone-green">
        <h3>Enviar oferta personalizada</h3>
        <p class="muted small">Si acordaron un trabajo, envía aquí tu cotización. El cliente la paga con un clic y queda protegida.</p>
        <form method="post" action="/conversacion/<%= c.id %>/oferta" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <input type="text" name="title" placeholder="¿Qué vas a entregar?" required>
          <div class="form-row"><input type="number" name="price" step="0.5" min="<%= settings.min_task_cents/100 %>" placeholder="Precio USD" required><input type="number" name="hours" min="1" max="720" placeholder="Horas" value="24"></div>
          <button class="btn btn-accent btn-block">Enviar oferta</button>
        </form>
      </div>
      <% } %>
      <% if (gig && gig.worker_id !== user.id && gig.status === 'active') { %>
        <div class="card"><h3>¿Listo para contratar?</h3><p class="muted small">Compra el servicio a precio fijo.</p>
          <form method="post" action="/servicios/<%= gig.id %>/comprar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-primary btn-block">Contratar por <%= money(gig.price_cents) %></button></form></div>
      <% } %>
      <div class="card flat tone-amber"><h3>¿Te pidieron contacto externo?</h3><p class="small">Denúncialo. Los reportes confirmados reciben un crédito para destacar publicaciones.</p>
        <form method="post" action="/reportar"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="type" value="user"><input type="hidden" name="id" value="<%= other.id %>"><input type="hidden" name="back" value="/conversacion/<%= c.id %>"><input type="hidden" name="reason" value="Solicitó contacto o pago por fuera de la plataforma (conversación #<%= c.id %>)"><button class="btn btn-sm btn-danger">Denunciar</button></form></div>
    </aside>
  </div>
</div>
<%- include('partials/foot') %>
