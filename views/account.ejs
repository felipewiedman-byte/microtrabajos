<%- include('partials/head') %>
<div class="container narrow">
  <div class="page-head"><h1>Mi cuenta</h1><p>Tu perfil público, seguridad y verificación.</p></div>
  <%- include('partials/verify-banner') %>
  <form class="card" method="post" action="/cuenta"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <h3>Perfil</h3>
    <div class="form-row"><div class="field"><label>Nombre</label><input type="text" name="name" value="<%= user.name %>"></div><div class="field"><label>País</label><select name="country"><% Object.entries(COUNTRIES).forEach(function([k,v]){ %><option value="<%= k %>" <%= user.country===k?'selected':'' %>><%= v %></option><% }) %></select></div></div>
    <div class="form-row"><div class="field"><label>Título profesional</label><input type="text" name="headline" value="<%= user.headline %>" placeholder="Ej.: Diseñadora gráfica"></div><div class="field"><label>Empresa (opcional)</label><input type="text" name="company" value="<%= user.company %>"></div></div>
    <div class="field"><label>Descripción</label><textarea name="bio"><%= user.bio %></textarea></div>
    <h3 class="mt">Trabajos en persona</h3>
    <div class="form-row"><div class="field"><label>Ciudad</label><%- include('partials/city-picker', { mode: 'field', value: user.city, legacy: true }) %></div><div class="field"><label>Barrio o sector</label><input type="text" name="zone" value="<%= user.zone %>"></div></div>
    <div class="field"><label>Disponibilidad</label><input type="text" name="availability" value="<%= user.availability %>" placeholder="Ej.: Lunes a viernes después de las 5 p. m. y sábados"></div>
    <label class="check mb"><input type="checkbox" name="works_presencial" value="1" <%= user.works_presencial ? 'checked' : '' %>> Acepto trabajos en persona en mi ciudad (requiere identidad verificada)</label>
    <div class="form-row"><div class="field"><label>Habilidades</label><input type="text" name="skills" value="<%= user.skills %>" placeholder="Separadas por comas"></div><div class="field"><label>Idiomas</label><input type="text" name="languages" value="<%= user.languages %>"></div></div>
    <button class="btn btn-primary">Guardar cambios</button> <a class="btn" href="/perfil/<%= user.id %>">Ver perfil público</a>
  </form>
  <div class="grid g2 mt">
    <form class="card" method="post" action="/cuenta/clave"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Contraseña</h3>
      <div class="field"><label>Actual</label><input type="password" name="current" required></div>
      <div class="field"><label>Nueva</label><input type="password" name="password" minlength="8" required></div>
      <button class="btn">Cambiar contraseña</button></form>
    <form class="card" id="verificacion" method="post" action="/cuenta/verificacion" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Verificación de identidad</h3>
      <% if (user.verified_id) { %><p><span class="badge ok">Identidad verificada</span></p><p class="muted small">Ya puedes retirar tus ganancias.</p>
      <% } else { %><p class="muted small">Sube una foto de tu documento de identidad (ambas caras en una imagen o PDF). Es obligatoria para retirar dinero.</p>
        <div class="field"><input type="file" name="document" accept="image/*,application/pdf" required></div><button class="btn">Enviar documento</button><% } %>
    </form>
  </div>
  <form class="card mt" method="post" action="/cuenta/avisos"><input type="hidden" name="_csrf" value="<%= csrf %>"><h3>Correo y avisos</h3>
    <p class="muted small">Correo: <strong><%= user.email %></strong> · <% if (user.email_verified) { %><span class="badge ok">Confirmado</span><% } else { %><span class="badge">Sin confirmar</span><% } %></p>
    <label class="check mb"><input type="checkbox" name="notify_email" value="1" <%= user.notify_email ? 'checked' : '' %>> Recibir avisos importantes por correo (ofertas, mensajes, pedidos). Máximo 10 por hora.</label>
    <button class="btn">Guardar</button>
  </form>
  <div class="card mt" id="privacidad"><h3>Privacidad y datos</h3>
    <p class="muted small">Tienes derecho a conocer y a eliminar tus datos personales.</p>
    <a class="btn btn-sm" href="/cuenta/datos.json">Descargar mis datos (JSON)</a>
    <details class="mt"><summary class="small"><strong style="color:var(--danger)">Eliminar mi cuenta</strong></summary>
      <form method="post" action="/cuenta/eliminar" class="mt-s" data-confirm="¿Seguro? Esta acción no se puede deshacer."><input type="hidden" name="_csrf" value="<%= csrf %>">
        <p class="small muted">Se borran tu perfil, mensajes y notificaciones, se cierran tus publicaciones y servicios y se anonimizan los registros que la ley obliga a conservar. <strong>Pierdes tus créditos</strong> (no se reembolsan). Si tienes pedidos o retiros en curso, termínalos primero.</p>
        <div class="field"><label>Tu contraseña</label><input type="password" name="password" required autocomplete="current-password"></div>
        <div class="field"><label>Escribe ELIMINAR para confirmar</label><input type="text" name="confirm" required autocomplete="off"></div>
        <button class="btn btn-danger">Eliminar mi cuenta definitivamente</button></form></details>
  </div>
</div>
<%- include('partials/foot') %>
