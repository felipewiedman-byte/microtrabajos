<%- include('partials/head') %>
<div class="container">
  <div class="page-head row between">
    <div><h1>Servicios a precio fijo</h1><p><%= creditsMode ? 'Profesionales con servicios publicados. Publica lo que necesitas y recibe sus ofertas gratis.' : 'Compra un servicio con un clic. Pago protegido hasta que apruebes la entrega.' %></p></div>
    <a class="btn btn-primary" href="/servicios/nuevo">Ofrecer mi servicio</a>
  </div>
  <form class="row mb" action="/servicios">
    <input type="search" name="q" value="<%= query.q || '' %>" placeholder="Buscar servicios" style="flex:1;min-width:200px">
    <select name="cat" style="width:auto;min-width:200px"><option value="">Todas las categorías</option><% cats.forEach(function(c){ %><option value="<%= c.slug %>" <%= query.cat === c.slug ? 'selected' : '' %>><%= c.name %></option><% }) %></select>
    <button class="btn btn-primary">Buscar</button>
  </form>
  <% if (gigs.length) { %><div class="grid g4"><% gigs.forEach(function(g){ %><%- include('partials/gig-card', { g }) %><% }) %></div>
  <% } else { %><div class="empty">No hay servicios con esos filtros.</div><% } %>
</div>
<%- include('partials/foot') %>
