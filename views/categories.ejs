<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Categorías</h1><p>Doce departamentos con cientos de microtareas digitales.</p></div>
  <div class="grid g3">
    <% cats.forEach(function(c, i){ %>
      <div class="card flat cat" style="--c:<%= CAT_COLORS[i % 12] %>">
        <span class="num"><%= String(i+1).padStart(2,'0') %> · <%= c.open_tasks %> abiertas</span>
        <h3 class="mt-s"><%= c.name %></h3>
        <ul class="muted small" style="padding-left:18px"><% JSON.parse(c.items).forEach(function(it){ %><li><%= it %></li><% }) %></ul>
        <div class="row"><a class="btn btn-sm btn-primary" href="/explorar?cat=<%= c.slug %>">Ver tareas</a><a class="btn btn-sm" href="/servicios?cat=<%= c.slug %>">Servicios</a></div>
      </div>
    <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
