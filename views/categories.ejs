<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Categorías</h1><p>Doce departamentos con cientos de microtareas digitales.</p></div>
  <div class="grid g3">
    <% cats.forEach(function(c, i){ %>
      <div class="card">
        <div class="row" style="flex-wrap:nowrap;align-items:flex-start"><span class="cat-ico" style="<%= catStyle(i) %>"><%- catIcon(c.slug, 18) %></span><div><h3 style="margin:0"><%= c.name %></h3><span class="muted small"><%= c.open_tasks %> abiertas · precio habitual $<%= c.price_hint %> USD</span></div></div>
        <ul class="muted small" style="padding-left:18px;margin:10px 0"><% JSON.parse(c.items).forEach(function(it){ %><li><%= it %></li><% }) %></ul>
        <div class="row"><a class="btn btn-sm btn-primary" href="/explorar?cat=<%= c.slug %>">Ver tareas</a><a class="btn btn-sm" href="/servicios?cat=<%= c.slug %>">Servicios</a><a class="btn btn-sm btn-ghost" href="/tareas/nueva?cat=<%= c.id %>">Publicar</a></div>
      </div>
    <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
