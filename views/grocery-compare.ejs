<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Compara tu mercado en <%= city %></h1><p>Calculamos la canasta completa en cada supermercado. Todo tu mercado sale de un solo lugar.</p></div>
  <% if (!results.length) { %><div class="empty">Ningún supermercado de <%= city %> tiene precios para estos productos todavía. <a href="/mercado"><u>Volver</u></a></div><% } %>
  <div class="stack">
  <% results.forEach(function(r, i){ %>
    <div class="card gx-res <%= i === 0 ? 'gx-best' : '' %>" style="--cc:<%= r.chain.color %>">
      <div class="gx-res-head">
        <div class="row"><span class="gx-logo"><%= r.chain.name.charAt(0) %></span><div><h3 style="margin:0"><%= r.chain.name %></h3><span class="small <%= r.complete ? '' : 'gx-warn' %>"><%= r.complete ? 'Canasta completa' : r.found + ' de ' + (r.found + r.missing.length) + ' productos disponibles' %></span></div></div>
        <div class="right"><% if (i === 0) { %><span class="badge warn">Mejor opción</span><br><% } %><span class="gx-total"><%= cop(r.total) %></span><span class="muted small"> mercado estimado</span></div>
      </div>
      <details><summary class="small">Ver detalle y pedir</summary>
        <table class="mt-s"><tbody>
          <% r.lines.forEach(function(l){ const p = products.find(x => x.id === l.id); %><tr><td><%= p.name %></td><td>× <%= l.qty %></td><td class="right"><%= cop(l.price * l.qty) %></td></tr><% }) %>
          <% r.missing.forEach(function(id){ const p = products.find(x => x.id === id); %><tr class="muted"><td><%= p.name %></td><td colspan="2" class="right">No disponible</td></tr><% }) %>
        </tbody></table>
        <dl class="dl mt">
          <dt>Mercado estimado</dt><dd><%= cop(r.q.estimate) %></dd>
          <dt>Reserva (+<%= settings.grocery_reserve_pct %> % por cambios de precio)</dt><dd><%= cop(r.q.reserve - r.q.estimate) %></dd>
          <dt>Servicio del comprador</dt><dd><%= cop(r.q.service) %></dd>
          <dt>Tarifa de la plataforma</dt><dd><%= cop(r.q.fee) %></dd>
          <dt class="total">Pagas ahora</dt><dd class="total"><%= cop(r.q.total) %> COP</dd>
        </dl>
        <p class="hint">Al final se cobra solo el valor del recibo. Lo que sobre de la reserva se te devuelve.</p>
        <% if (user) { %>
        <form method="post" action="/mercado/pedido" class="stack mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="chain_id" value="<%= r.chain.id %>">
          <% Object.entries(cart).forEach(function([id, q]){ %><input type="hidden" name="q<%= id %>" value="<%= q %>"><% }) %>
          <div class="form-row"><input type="text" name="zone" maxlength="80" placeholder="Barrio" required value="<%= user.zone || '' %>"><input type="text" name="address" maxlength="200" placeholder="Dirección (privada)" required></div>
          <div class="form-row"><input type="datetime-local" name="scheduled_at"><input type="text" name="notes" maxlength="500" placeholder="Indicaciones (opcional)"></div>
          <label class="check small"><input type="checkbox" name="substitutions" value="1" checked> Si un producto no está, acepto uno equivalente de precio similar</label>
          <button class="btn btn-primary btn-block">Pedir en <%= r.chain.name %> · pagar <%= cop(r.q.total) %></button>
        </form>
        <% } else { %><a class="btn btn-primary btn-block mt" href="/ingresar?next=/mercado">Ingresa para pedir</a><% } %>
      </details>
    </div>
  <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
