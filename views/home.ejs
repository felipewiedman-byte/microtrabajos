<%- include('partials/head') %>
<%
  const show = (k) => String(settings['show_' + k]) !== '0';
  const custom = (pos) => sections.filter((s) => s.position === pos);
  const heroImg = settings.hero_image ? '/media/' + settings.hero_image : (String(settings.hero_default) !== '0' ? '/static/img/hero-ejecutivo.svg' : '');
  const PALETTE = ['#4f46e5', '#0891b2', '#db2777', '#059669', '#ea580c', '#7c3aed', '#2563eb', '#ca8a04', '#0d9488', '#e11d48', '#16a34a', '#9333ea', '#f59e0b', '#06b6d4', '#ec4899', '#10b981', '#8b5cf6', '#ef4444', '#3b82f6', '#14b8a6'];
%>
<% function renderSections(pos) { custom(pos).forEach(function (s) { %>
<section class="csec" style="background:<%= s.bg_color %>;color:<%= s.text_color %>"><div class="container">
  <% if (s.eyebrow) { %><span class="eyebrow"><%= s.eyebrow %></span><% } %><h2><%= s.title %></h2>
  <% if (s.body) { %><p><%= s.body %></p><% } %>
  <% if (s.button_text && s.button_link) { %><a class="btn btn-primary" href="<%= s.button_link %>"><%= s.button_text %></a><% } %>
</div></section>
<% }) } %>

<!-- BANNERS -->
<section class="mk-hero">
  <div class="mk-slides" data-carousel>
    <div class="mk-slide on" style="--g1:#312e81;--g2:#6d28d9">
      <div class="container mk-slide-in">
        <div>
          <span class="mk-kicker"><%- icon('shield', 14) %> <%= t('home.b1.etiqueta', 'Pago protegido en toda la plataforma') %></span>
          <h1><%= t('home.b1.titulo', 'Necesitas algo. Alguien te ayuda. Ambos ganan.') %></h1>
          <p><%= t('home.b1.texto', 'Publica lo que necesitas y cuánto pagas: reparaciones, mandados, mascotas, diseño, Excel y mucho más. Personas verificadas de tu ciudad te ayudan.') %></p>
          <div class="row"><a class="btn mk-btn-light" href="/tareas/nueva"><%= t('home.b1.boton1', 'Publicar lo que necesito') %></a><a class="btn mk-btn-ghost" href="/explorar"><%= t('home.b1.boton2', 'Quiero ganar dinero') %></a></div>
        </div>
        <% if (heroImg) { %><img class="mk-art" src="<%= heroImg %>" alt=""><% } %>
      </div>
    </div>
    <div class="mk-slide" style="--g1:#065f46;--g2:#0d9488">
      <div class="container mk-slide-in">
        <div>
          <span class="mk-kicker"><%- icon('mappin', 14) %> <%= t('home.b2.etiqueta', 'Ayuda en persona') %></span>
          <h2 class="mk-h"><%= t('home.b2.titulo', 'Gana dinero ayudando en tu barrio') %></h2>
          <p><%= t('home.b2.texto', 'Montar muebles, pasear perros, ayudar en una mudanza o hacer mandados. Tú eliges qué, cuándo y dónde.') %></p>
          <div class="row"><a class="btn mk-btn-light" href="/explorar?modalidad=presencial"><%= t('home.b2.boton', 'Ver ayuda cerca de mí') %></a></div>
        </div>
        <div class="mk-badges"><span><%- icon('tool', 28) %></span><span><%- icon('paw', 28) %></span><span><%- icon('truck', 28) %></span><span><%- icon('bag', 28) %></span></div>
      </div>
    </div>
    <div class="mk-slide" style="--g1:#9a3412;--g2:#db2777">
      <div class="container mk-slide-in">
        <div>
          <span class="mk-kicker"><%- icon('question', 14) %> <%= t('home.b3.etiqueta', 'Resuelve mi problema') %></span>
          <h2 class="mk-h"><%= t('home.b3.titulo', '¿No sabes cuánto cuesta? Recibe ofertas') %></h2>
          <p><%= t('home.b3.texto', 'Describe tu problema y deja que las personas te coticen. Eliges la mejor oferta y pagas protegido.') %></p>
          <div class="row"><a class="btn mk-btn-light" href="/tareas/nueva?precio=open"><%= t('home.b3.boton', 'Describir mi problema') %></a></div>
        </div>
        <div class="mk-badges"><span><%- icon('plug', 28) %></span><span><%- icon('monitor', 28) %></span><span><%- icon('home', 28) %></span><span><%- icon('chat', 28) %></span></div>
      </div>
    </div>
    <button class="mk-nav mk-prev" type="button" aria-label="Anterior"><%- icon('arrow', 18) %></button>
    <button class="mk-nav mk-next" type="button" aria-label="Siguiente"><%- icon('arrow', 18) %></button>
    <div class="mk-dots"><button class="on" aria-label="1"></button><button aria-label="2"></button><button aria-label="3"></button></div>
  </div>
</section>

<!-- ACCESOS RÁPIDOS -->
<section class="mk-quick"><div class="container">
  <div class="mk-quick-grid">
    <a href="/explorar?modalidad=presencial" style="--q:#4f46e5"><span class="mk-qi"><%- icon('home', 22) %></span><strong><%= t('home.q1.titulo', 'Ayuda en persona') %></strong><small><%= t('home.q1.texto', 'Hogar, mudanzas, mascotas y mandados') %></small></a>
    <a href="/explorar?modalidad=digital" style="--q:#0891b2"><span class="mk-qi"><%- icon('monitor', 22) %></span><strong><%= t('home.q2.titulo', 'Trabajos digitales') %></strong><small><%= t('home.q2.texto', 'Diseño, textos, video y datos') %></small></a>
    <a href="/explorar?precio=hourly" style="--q:#7c3aed"><span class="mk-qi"><%- icon('hourglass', 22) %></span><strong><%= t('home.q3.titulo', 'Ayuda por horas') %></strong><small><%= t('home.q3.texto', 'Alguien que te apoye unas horas') %></small></a>
    <a href="/explorar?precio=open" style="--q:#db2777"><span class="mk-qi"><%- icon('question', 22) %></span><strong><%= t('home.q4.titulo', 'Resuelve mi problema') %></strong><small><%= t('home.q4.texto', 'Describe y recibe ofertas') %></small></a>
    <a href="/registro" style="--q:#059669"><span class="mk-qi"><%- icon('wallet', 22) %></span><strong><%= t('home.q5.titulo', 'Gana dinero ayudando') %></strong><small><%= t('home.q5.texto', 'Crea tu perfil gratis') %></small></a>
  </div>
</div></section>
<% renderSections('after_hero') %>

<% if (show('categories')) { %>
<section class="mk-sec"><div class="container">
  <div class="mk-head"><h2><%= t('home.categorias.titulo', 'Encuentra ayuda para todo') %></h2><a href="/categorias"><%= t('home.categorias.boton', 'Ver todas las categorías') %> <%- icon('arrow', 14) %></a></div>
  <div class="mk-cats">
    <% navCats.forEach(function(c, i){ %><a href="/explorar?cat=<%= c.slug %>" style="--k:<%= PALETTE[i % PALETTE.length] %>"><span><%- catIcon(c.slug, 24) %></span><b><%= c.name %></b></a><% }) %>
  </div>
</div></section>
<% } %>
<% renderSections('after_categories') %>

<% function row(title, link, linkText, items, kind, empty) { %>
<section class="mk-sec"><div class="container">
  <div class="mk-head"><h2><%= title %></h2><a href="<%= link %>"><%= linkText %> <%- icon('arrow', 14) %></a></div>
  <% if (items.length) { %>
  <div class="slider" data-slider><button class="sl-btn sl-prev" type="button" aria-label="Anterior"><%- icon('arrow', 18) %></button><div class="sl-track"><% items.forEach(function(it){ %><div class="sl-item"><% if (kind === 'gig') { %><%- include('partials/gig-card', { g: it }) %><% } else { %><%- include('partials/task-card', { t: it }) %><% } %></div><% }) %></div><button class="sl-btn sl-next" type="button" aria-label="Siguiente"><%- icon('arrow', 18) %></button></div>
  <% } else { %><div class="mk-empty"><%- icon('search', 20) %><span><%= empty %></span><a class="btn btn-primary btn-sm" href="/tareas/nueva">Publicar la primera</a></div><% } %>
</div></section>
<% } %>

<% if (show('tasks')) { row(city ? t('home.cerca.titulo', 'Ayuda en persona en') + ' ' + city : t('home.cerca.titulo2', 'Ayuda en persona'), '/explorar?modalidad=presencial', 'Ver todo', near, 'task', city ? 'Aún no hay publicaciones en ' + city + '.' : 'Aún no hay publicaciones en persona.'); } %>
<% if (show('tasks')) { row(t('home.digital.titulo', 'Trabajos digitales'), '/explorar?modalidad=digital', 'Ver todo', tasks, 'task', 'Aún no hay trabajos digitales publicados.'); } %>

<% if (show('paths')) { %>
<section class="mk-sec"><div class="container mk-promos">
  <a href="/registro" class="mk-promo" style="--g1:#4338ca;--g2:#7c3aed"><div><small><%= t('home.promo1.etiqueta', 'Para quienes ayudan') %></small><h3><%= t('home.promo1.titulo', 'Convierte tu tiempo libre en ingresos') %></h3><p><%= t('home.promo1.texto', 'Elige tareas cerca de ti o desde casa. Cobras seguro y retiras a Nequi, banco o PayPal.') %></p><span class="btn mk-btn-light btn-sm"><%= t('home.promo1.boton', 'Empezar a ganar') %></span></div><%- icon('wallet', 64) %></a>
  <a href="/cuenta#verificacion" class="mk-promo" style="--g1:#0f766e;--g2:#0891b2"><div><small><%= t('home.promo2.etiqueta', 'Confianza') %></small><h3><%= t('home.promo2.titulo', 'Perfiles verificados para trabajos en persona') %></h3><p><%= t('home.promo2.texto', 'Solo personas con identidad verificada pueden aceptar trabajos en tu casa.') %></p><span class="btn mk-btn-light btn-sm"><%= t('home.promo2.boton', 'Verificar mi identidad') %></span></div><%- icon('shield', 64) %></a>
</div></section>
<% } %>

<% if (show('tasks') && hourly.length) { row(t('home.horas.titulo', 'Por horas y para ofertar'), '/explorar?precio=hourly', 'Ver todo', hourly, 'task', ''); } %>
<% if (show('gigs') && gigs.length) { row(t('home.servicios.titulo', 'Servicios a precio fijo'), '/servicios', 'Ver todos', gigs, 'gig', ''); } %>

<% if (show('features')) { %>
<section class="mk-sec"><div class="container">
  <div class="mk-trust">
    <div><span style="--q:#4f46e5"><%- icon('lock', 22) %></span><div><strong><%= t('home.c1.titulo', 'Pago protegido') %></strong><small><%= t('home.c1.texto', 'El dinero se libera solo cuando el trabajo está hecho.') %></small></div></div>
    <div><span style="--q:#059669"><%- icon('key', 22) %></span><div><strong><%= t('home.c2.titulo', 'Código de cierre') %></strong><small><%= t('home.c2.texto', 'En trabajos en persona, tú confirmas con un código.') %></small></div></div>
    <div><span style="--q:#0891b2"><%- icon('shield', 22) %></span><div><strong><%= t('home.c3.titulo', 'Personas verificadas') %></strong><small><%= t('home.c3.texto', 'Identidad verificada y reseñas reales.') %></small></div></div>
    <div><span style="--q:#db2777"><%- icon('scale', 22) %></span><div><strong><%= t('home.c4.titulo', 'Disputas y soporte') %></strong><small><%= t('home.c4.texto', 'Si algo sale mal, te ayudamos a resolverlo.') %></small></div></div>
  </div>
</div></section>
<% } %>
<% renderSections('before_cta') %>

<% if (show('payments')) { %>
<section class="mk-sec" style="padding-top:0"><div class="container paystrip"><span class="muted small"><%= t('home.pagos.texto', 'Paga con') %></span><b>Mercado Pago</b><b>PayPal</b><b>PSE</b><b>Nequi</b><b>Visa</b><b>Mastercard</b></div></section>
<% } %>

<% if (String(settings.show_newsletter) !== '0') { %>
<section class="news" id="boletin">
  <div class="container news-in">
    <div><h2><%= t('home.boletin.titulo', 'Recibe nuevas oportunidades en tu correo') %></h2><p><%= t('home.boletin.texto', 'Tareas nuevas en tu ciudad, consejos para ganar más y novedades. Sin spam.') %></p></div>
    <form class="news-form" method="post" action="/suscribir"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="email" name="email" required placeholder="<%= t('home.boletin.campo', 'Tu correo electrónico') %>" aria-label="Correo"><button class="btn" aria-label="Suscribirme"><%- icon('send', 16) %> <span><%= t('home.boletin.boton', 'Suscribirme') %></span></button></form>
  </div>
</section>
<% } %>
<% renderSections('end') %>
<%- include('partials/foot') %>
