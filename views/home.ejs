  <div class="mk-head"><div class="mk-title"><span class="mk-tico"><%- icon('wallet', 20) %></span><div><small><%= t('home.ganar.etiqueta', 'Para quienes ayudan') %></small><h2><%= t('home.ganar.titulo', 'Cómo ganas dinero y por qué tus ingresos están seguros') %></h2></div></div><a href="/registro"><%= t('home.ganar.boton', 'Empezar a ganar') %> <%- icon('arrow', 14) %></a></div>
