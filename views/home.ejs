<%- include('partials/head') %>
<%
  const show = (k) => String(settings['show_' + k]) !== '0';
  const custom = (pos) => sections.filter((s) => s.position === pos);
%>
<% function renderSections(pos) { custom(pos).forEach(function (s) { %>
<section class="csec" style="background:<%= s.bg_color %>;color:<%= s.text_color %>">
  <div class="container">
    <% if (s.eyebrow) { %><span class="eyebrow"><%= s.eyebrow %></span><% } %>
    <h2><%= s.title %></h2>
    <% if (s.body) { %><p><%= s.body %></p><% } %>
    <% if (s.button_text && s.button_link) { %><a class="btn btn-primary" href="<%= s.button_link %>"><%= s.button_text %></a><% } %>
  </div>
</section>
<% }) } %>

<!-- PORTADA -->
<section class="hx">
  <div class="container hx-grid">
    <div>
      <span class="hx-pill"><%- icon('shield', 14) %> <%= t('home.hero.etiqueta', 'Pago protegido · Colombia y Latinoamérica') %></span>
      <h1><%= t('home.hero.titulo', 'Trabajos digitales pequeños, rápidos y seguros.') %></h1>
      <p><%= t('home.hero.texto', 'Publica lo que necesitas o gana dinero con lo que sabes hacer. Contrata, paga y recibe la entrega en un solo lugar.') %></p>
      <form class="hx-search" action="/explorar">
        <%- icon('search', 18) %><input type="search" name="q" placeholder="<%= t('home.hero.buscador', '¿Qué necesitas? Ej.: flyer, transcripción, Excel') %>" aria-label="Buscar">
        <button class="btn btn-dark"><%= t('home.hero.boton_buscar', 'Buscar') %></button>
      </form>
      <div class="hx-actions">
        <a class="btn btn-amber" href="/tareas/nueva"><%= t('home.hero.boton1', 'Publicar una tarea') %></a>
        <a class="btn btn-white" href="/servicios/nuevo"><%= t('home.hero.boton2', 'Ofrecer mis servicios') %></a>
      </div>
      <ul class="hx-checks"><li><%- icon('check', 14) %> <%= t('home.hero.check1', 'Publicar es gratis') %></li><li><%- icon('check', 14) %> <%= t('home.hero.check2', 'Pagas solo al aprobar') %></li><li><%- icon('check', 14) %> <%= t('home.hero.check3', 'Retiros a Nequi, banco o PayPal') %></li></ul>
    </div>
    <div class="hx-side">
      <div class="hx-tiles">
        <a href="/explorar?cat=diseno-grafico" class="hx-tile" style="--t:#2563eb"><span><%- catIcon('diseno-grafico', 30) %></span><%= t('home.hero.mosaico1', 'Diseño') %></a>
        <a href="/explorar?cat=edicion-audiovisual" class="hx-tile" style="--t:#db2777"><span><%- catIcon('edicion-audiovisual', 30) %></span><%= t('home.hero.mosaico2', 'Video y audio') %></a>
        <a href="/explorar?cat=escritura-traduccion" class="hx-tile" style="--t:#0d9488"><span><%- catIcon('escritura-traduccion', 30) %></span><%= t('home.hero.mosaico3', 'Escritura') %></a>
        <a href="/explorar?cat=datos-organizacion" class="hx-tile" style="--t:#d97706"><span><%- catIcon('datos-organizacion', 30) %></span><%= t('home.hero.mosaico4', 'Datos y Excel') %></a>
      </div>
      <div class="hx-stat"><strong><%= stats.tasks %> <%= t('home.hero.stat_titulo', 'tareas abiertas') %></strong><span><%= t('home.hero.stat_texto', '12 categorías · trabajos desde $3 USD · entrega en horas') %></span></div>
    </div>
  </div>
</section>
<% renderSections('after_hero') %>

<% if (show('paths')) { %>
<section class="sec sec-white">
  <div class="container grid g3">
    <div class="solid" style="--s:var(--brand)">
      <span class="solid-tag"><%= t('home.caminos.cliente_etiqueta', 'Para clientes') %></span>
      <h3><%= t('home.caminos.cliente_titulo', '¿Necesitas que hagan un trabajo?') %></h3>
      <p><%= t('home.caminos.cliente_texto', 'Publica tu tarea con precio y plazo. Recibe postulaciones de trabajadores calificados y paga solo cuando apruebes la entrega.') %></p>
      <div class="row"><a class="btn btn-white btn-sm" href="/tareas/nueva"><%= t('home.caminos.cliente_boton1', 'Publicar tarea') %></a><a class="btn btn-line btn-sm" href="/servicios"><%= t('home.caminos.cliente_boton2', 'Ver servicios') %></a></div>
    </div>
    <div class="solid" style="--s:var(--c-success)">
      <span class="solid-tag"><%= t('home.caminos.trabajador_etiqueta', 'Para trabajadores') %></span>
      <h3><%= t('home.caminos.trabajador_titulo', '¿Quieres ganar dinero con tus habilidades?') %></h3>
      <p><%= t('home.caminos.trabajador_texto', 'Publica tus servicios a precio fijo y postúlate a tareas. Cobra seguro y retira a Nequi, banco, Mercado Pago o PayPal.') %></p>
      <div class="row"><a class="btn btn-white btn-sm" href="/servicios/nuevo"><%= t('home.caminos.trabajador_boton1', 'Ofrecer servicio') %></a><a class="btn btn-line btn-sm" href="/explorar"><%= t('home.caminos.trabajador_boton2', 'Buscar tareas') %></a></div>
    </div>
    <div class="solid" style="--s:var(--c-warning)">
      <span class="solid-tag"><%= t('home.caminos.express_etiqueta', 'Express') %></span>
      <h3><%= t('home.caminos.express_titulo', '¿Es urgente? Entregas en horas.') %></h3>
      <p><%= t('home.caminos.express_texto', 'Publica en Express y los trabajadores disponibles toman tu tarea de inmediato: flyers, subtítulos, correcciones y más.') %></p>
      <div class="row"><a class="btn btn-white btn-sm" href="/explorar?express=1"><%= t('home.caminos.express_boton1', 'Ver Express') %></a><a class="btn btn-line btn-sm" href="/tareas/nueva"><%= t('home.caminos.express_boton2', 'Publicar urgente') %></a></div>
    </div>
  </div>
</section>
<% } %>

<% if (show('categories')) { %>
<section class="sec sec-soft">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.categorias.etiqueta', 'Categorías') %></span><h2><%= t('home.categorias.titulo', 'Encuentra ayuda para todo lo digital') %></h2></div><a class="btn btn-sm" href="/categorias"><%= t('home.categorias.boton', 'Ver todas') %></a></div>
    <div class="grid g4">
      <% cats.forEach(function(c, i){ %>
        <a class="cat" style="<%= catStyle(i) %>" href="/explorar?cat=<%= c.slug %>"><span class="cat-ico"><%- catIcon(c.slug, 18) %></span><span><strong><%= c.name %></strong><small><%= c.open_tasks %> abiertas · $<%= c.price_hint %> USD</small></span></a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>
<% renderSections('after_categories') %>

<% if (show('tasks')) { %>
<section class="sec sec-white">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.tareas.etiqueta', 'Publicadas por clientes') %></span><h2><%= t('home.tareas.titulo', 'Tareas disponibles ahora') %></h2></div><a class="btn btn-sm" href="/explorar"><%= t('home.tareas.boton', 'Ver todas') %></a></div>
    <% if (tasks.length) { %>
      <div class="grid g3"><% tasks.forEach(function(t){ %><%- include('partials/task-card', { t }) %><% }) %></div>
    <% } else { %><div class="empty"><%= t('home.tareas.vacio', 'Aún no hay tareas publicadas.') %> <a href="/tareas/nueva"><strong><%= t('home.tareas.vacio_boton', 'Publique la primera') %></strong></a>.</div><% } %>
  </div>
</section>
<% } %>

<% if (show('figures')) { %>
<section class="sec sec-navy">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.cifras.etiqueta', 'Reglas claras') %></span><h2><%= t('home.cifras.titulo', 'Precios transparentes, sin sorpresas') %></h2></div></div>
    <div class="grid g4">
      <div class="figure" style="--s:var(--brand)"><strong><%= money(settings.min_task_cents).replace(' USD','') %></strong><span><%= t('home.cifras.texto1', 'Precio mínimo por tarea, en USD o su equivalente en pesos.') %></span></div>
      <div class="figure" style="--s:var(--c-success)"><strong>0 %</strong><span><%= t('home.cifras.texto2', 'Cuesta publicar una tarea o un servicio. Pagas solo cuando contratas.') %></span></div>
      <div class="figure" style="--s:var(--c-warning)"><strong><%= settings.client_fee_pct %> %</strong><span><%= t('home.cifras.texto3', 'Tarifa de servicio al cliente por cada contratación protegida.') %></span></div>
      <div class="figure" style="--s:#6d28d9"><strong><%= settings.auto_approve_hours %> h</strong><span><%= t('home.cifras.texto4', 'Para revisar la entrega. Después se aprueba y se libera el pago.') %></span></div>
    </div>
  </div>
</section>
<% } %>

<% if (show('how')) { %>
<section class="sec sec-white">
  <div class="container split">
    <div>
      <span class="eyebrow"><%= t('home.como.etiqueta', 'Cómo funciona') %></span>
      <h2 class="big"><%= t('home.como.titulo', 'Del encargo al pago, todo queda registrado y protegido') %></h2>
      <p class="muted"><%= t('home.como.texto1', 'MICROTRABAJO conecta a quien necesita un trabajo con quien sabe hacerlo. El dinero lo retiene el proveedor de pagos y solo se libera cuando el cliente aprueba la entrega.') %></p>
      <p class="muted"><%= t('home.como.texto2', 'Cada pedido tiene su chat, sus archivos, su historial y su centro de disputas. Si algo sale mal, un moderador revisa el caso y decide.') %></p>
      <div class="row mt"><a class="btn btn-primary" href="/como-funciona"><%= t('home.como.boton1', 'Ver cómo funciona') %></a><a class="btn" href="/seguridad"><%= t('home.como.boton2', 'Centro de seguridad') %></a></div>
    </div>
    <div class="mock">
      <div class="mock-head"><span><%- icon('file', 16) %> <%= t('home.como.ejemplo_titulo', 'Seguimiento del pedido') %></span><span class="badge ok">Ejemplo</span></div>
      <div class="mock-row"><span class="mi" style="--s:var(--brand)"><%- icon('card', 16) %></span><div><strong><%= t('home.como.paso1', 'Pago confirmado · $10.50 USD') %></strong><small><%= t('home.como.paso1_detalle', 'Mercado Pago · dinero retenido') %></small></div></div>
      <div class="mock-row"><span class="mi" style="--s:var(--c-warning)"><%- icon('clock', 16) %></span><div><strong><%= t('home.como.paso2', 'En ejecución · entrega en 24 h') %></strong><small><%= t('home.como.paso2_detalle', 'Diseño de flyer publicitario') %></small></div></div>
      <div class="mock-row"><span class="mi" style="--s:#6d28d9"><%- icon('clip', 16) %></span><div><strong><%= t('home.como.paso3', 'Entrega recibida · flyer-final.png') %></strong><small><%= t('home.como.paso3_detalle', 'Incluye 2 correcciones') %></small></div></div>
      <div class="mock-row"><span class="mi" style="--s:var(--c-success)"><%- icon('check', 16) %></span><div><strong><%= t('home.como.paso4', 'Aprobado · pago liberado') %></strong><small><%= t('home.como.paso4_detalle', 'El trabajador recibe $8.50 USD') %></small></div></div>
    </div>
  </div>
</section>
<% } %>

<% if (show('gigs') && gigs.length) { %>
<section class="sec sec-soft">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.servicios.etiqueta', 'Ofrecidos por trabajadores') %></span><h2><%= t('home.servicios.titulo', 'Servicios a precio fijo') %></h2></div><a class="btn btn-sm" href="/servicios"><%= t('home.servicios.boton', 'Ver todos') %></a></div>
    <div class="grid g4"><% gigs.forEach(function(g){ %><%- include('partials/gig-card', { g }) %><% }) %></div>
  </div>
</section>
<% } %>

<% if (show('plans')) { %>
<section class="sec sec-white">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.planes.etiqueta', 'Planes') %></span><h2><%= t('home.planes.titulo', 'Empieza gratis, crece cuando lo necesites') %></h2></div><a class="btn btn-sm" href="/planes"><%= t('home.planes.boton', 'Comparar planes') %></a></div>
    <div class="grid g3">
      <div class="pcard" style="--s:#334155"><div class="pcard-top"><span><%= t('home.planes.gratis_etiqueta', 'Para empezar') %></span><h3><%= t('home.planes.gratis_nombre', 'Gratis') %></h3><strong>$0</strong><small><%= t('home.planes.gratis_periodo', 'siempre') %></small></div>
        <ul><li><%= t('home.planes.gratis_1', 'Contratar y trabajar') %></li><li><%= t('home.planes.gratis_2', '10 postulaciones al día') %></li><li><%= t('home.planes.gratis_3', '5 servicios activos') %></li><li>Comisión del <%= settings.commission_pct %> %</li></ul><a class="btn btn-block" href="/registro"><%= t('home.planes.gratis_boton', 'Crear cuenta gratis') %></a></div>
      <div class="pcard" style="--s:var(--brand)"><div class="pcard-top"><span><%= t('home.planes.pro_etiqueta', 'Para trabajadores · Recomendado') %></span><h3><%= t('home.planes.pro_nombre', 'Pro') %></h3><strong><%= money(settings.plan_pro_cents).replace(' USD','') %></strong><small>USD / mes</small></div>
        <ul><li>Comisión reducida al <%= settings.pro_commission_pct %> %</li><li><%= t('home.planes.pro_2', '50 postulaciones al día') %></li><li><%= t('home.planes.pro_3', '30 servicios activos') %></li><li><%= t('home.planes.pro_4', 'Perfil promocionado') %></li></ul><a class="btn btn-primary btn-block" href="/planes"><%= t('home.planes.pro_boton', 'Activar Pro') %></a></div>
      <div class="pcard" style="--s:var(--c-success)"><div class="pcard-top"><span><%= t('home.planes.business_etiqueta', 'Para empresas') %></span><h3><%= t('home.planes.business_nombre', 'Business') %></h3><strong><%= money(settings.plan_business_cents).replace(' USD','') %></strong><small>USD / mes</small></div>
        <ul><li><%= t('home.planes.business_1', 'Todo lo de Pro') %></li><li><%= t('home.planes.business_2', 'Publicación masiva por unidades') %></li><li><%= t('home.planes.business_3', 'Reportes de contratación') %></li><li><%= t('home.planes.business_4', 'Soporte prioritario') %></li></ul><a class="btn btn-accent btn-block" href="/planes"><%= t('home.planes.business_boton', 'Activar Business') %></a></div>
    </div>
  </div>
</section>
<% } %>

<% if (show('features')) { %>
<section class="sec sec-soft">
  <div class="container">
    <div class="sec-head"><div><span class="eyebrow"><%= t('home.funciones.etiqueta', 'Funciones') %></span><h2><%= t('home.funciones.titulo', 'Todo lo que necesitas en un solo lugar') %></h2></div></div>
    <div class="grid g3">
      <div class="feat"><span class="mi" style="--s:var(--brand)"><%- icon('lock', 18) %></span><div><strong><%= t('home.funciones.f1_titulo', 'Pago protegido') %></strong><p><%= t('home.funciones.f1_texto', 'El dinero queda retenido hasta que apruebas la entrega.') %></p></div></div>
      <div class="feat"><span class="mi" style="--s:#b91c1c"><%- icon('scale', 18) %></span><div><strong><%= t('home.funciones.f2_titulo', 'Centro de disputas') %></strong><p><%= t('home.funciones.f2_texto', 'Moderadores revisan el chat y los archivos y deciden.') %></p></div></div>
      <div class="feat"><span class="mi" style="--s:#0d9488"><%- icon('chat', 18) %></span><div><strong><%= t('home.funciones.f3_titulo', 'Chat y archivos por pedido') %></strong><p><%= t('home.funciones.f3_texto', 'Toda la conversación y las entregas en un solo historial.') %></p></div></div>
      <div class="feat"><span class="mi" style="--s:var(--c-warning)"><%- icon('wallet', 18) %></span><div><strong><%= t('home.funciones.f4_titulo', 'Billetera y retiros') %></strong><p><%= t('home.funciones.f4_texto', 'Ganancias claras y retiros a Nequi, banco o PayPal.') %></p></div></div>
      <div class="feat"><span class="mi" style="--s:#6d28d9"><%- icon('star', 18) %></span><div><strong><%= t('home.funciones.f5_titulo', 'Reputación verificada') %></strong><p><%= t('home.funciones.f5_texto', 'Solo quien pagó puede calificar. Niveles por desempeño.') %></p></div></div>
      <div class="feat"><span class="mi" style="--s:var(--c-success)"><%- icon('users', 18) %></span><div><strong><%= t('home.funciones.f6_titulo', 'Trabajo por unidades') %></strong><p><%= t('home.funciones.f6_texto', 'Divide 100 fotos en 100 microtareas para varias personas.') %></p></div></div>
    </div>
    <div class="note mt"><span class="mi" style="--s:var(--brand)"><%- icon('shield', 16) %></span><div><strong><%= t('home.funciones.nota_titulo', 'Tu seguridad primero.') %></strong> <%= t('home.funciones.nota_texto', 'Los mensajes con teléfonos, correos o redes sociales no se envían, para que nadie pierda la protección del pago. Tus datos se tratan conforme a la Ley 1581 de 2012.') %></div><a class="btn btn-sm" href="/privacidad"><%= t('home.funciones.nota_boton', 'Política de datos') %></a></div>
  </div>
</section>
<% } %>
<% renderSections('before_cta') %>

<% if (show('payments')) { %>
<section class="sec sec-white" style="padding:18px 0">
  <div class="container paystrip"><span class="muted small"><%= t('home.pagos.texto', 'Pagos procesados por') %></span><b>Mercado Pago</b><b>PayPal</b><b>Visa</b><b>Mastercard</b><b>PSE</b><b>Nequi</b></div>
</section>
<% } %>

<% if (show('cta')) { %>
<section class="cta">
  <div class="container center">
    <h2><%= t('home.final.titulo', '¿Tienes una tarea pendiente o un talento para ofrecer?') %></h2>
    <p><%= t('home.final.texto', 'Crea tu cuenta en un minuto. Es gratis.') %></p>
    <div class="row" style="justify-content:center"><a class="btn btn-amber" href="/registro"><%= t('home.final.boton1', 'Crear cuenta gratis') %></a><a class="btn btn-white" href="/explorar"><%= t('home.final.boton2', 'Explorar tareas') %></a></div>
  </div>
</section>
<% } %>
<% renderSections('end') %>
<%- include('partials/foot') %>
