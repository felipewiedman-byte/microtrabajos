<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><span class="badge"><%= gig.cat_name %></span> <%- gig.status !== 'active' ? badge(gig.status) : '' %><h1 class="mt-s"><%= gig.title %></h1></div>
  <div class="layout">
    <div class="stack">
      <div class="card">
        <div class="row mb"><span class="avatar"><%= gig.worker_name.charAt(0) %></span><div><a href="/perfil/<%= gig.worker_id %>"><strong><%= gig.worker_name %></strong></a> <span class="badge"><%= stats.level %></span><br><span class="muted small"><%= gig.headline %> <% if (stats.rating) { %>· <span class="stars">★</span> <%= stats.rating %> (<%= stats.reviews %>)<% } %> · <%= stats.done %> trabajos</span></div></div>
        <h3>Descripción del servicio</h3>
        <p style="white-space:pre-wrap"><%= gig.description %></p>
      </div>
      <div class="card">
        <h3>Opiniones verificadas</h3>
        <% if (!reviews.length) { %><p class="muted">Aún sin opiniones.</p><% } %>
        <% reviews.forEach(function(rv){ %><div class="list-row"><div><span class="stars"><%= stars(rv.rating) %></span> <strong class="small"><%= rv.name %></strong><p class="small muted" style="margin:4px 0 0"><%= rv.comment %></p></div><span class="muted small"><%= ago(rv.created_at) %></span></div><% }) %>
      </div>
    </div>
    <aside class="card sticky">
      <div class="row between"><span class="muted">Precio</span><span class="price" style="font-size:1.6rem"><%= money(gig.price_cents) %></span></div>
      <dl class="dl mt"><dt>Entrega</dt><dd><%= hours(gig.delivery_hours) %></dd><dt>Correcciones</dt><dd><%= gig.revisions %></dd><dt>Tarifa de servicio</dt><dd><%= money(fee) %></dd><dt class="total">Total</dt><dd class="total"><%= money(gig.price_cents + fee) %></dd></dl>
      <% if (user && user.id === gig.worker_id) { %>
        <form method="post" action="/servicios/<%= gig.id %>/pausar" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-block"><%= gig.status === 'active' ? 'Pausar servicio' : 'Activar servicio' %></button></form>
      <% } else if (user) { %>
        <form method="post" action="/servicios/<%= gig.id %>/comprar" class="mt"><input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field"><label>Instrucciones para el trabajador</label><textarea name="brief" placeholder="Describe lo que necesitas (opcional)" style="min-height:90px"></textarea></div>
          <button class="btn btn-primary btn-block">Contratar y pagar</button></form>
      <% } else { %><a class="btn btn-primary btn-block mt" href="/ingresar?next=/servicios/<%= gig.id %>">Ingresar para contratar</a><% } %>
      <p class="muted small center mt-s">Pago protegido · Liberado al aprobar</p>
    </aside>
  </div>
</div>
<%- include('partials/foot') %>
