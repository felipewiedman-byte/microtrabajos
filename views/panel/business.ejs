<%- include('../partials/head') %>
<div class="page-h"><h1>Mi negocio</h1><a class="btn" href="/t/<%= shop.slug %>" target="_blank" rel="noopener"><%- icon('eye', 16) %> Ver catálogo</a></div>
<form method="post" action="/panel/negocio" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="card"><h3>Identidad</h3>
  <div class="two">
    <div class="field"><label for="n">Nombre</label><input id="n" name="name" value="<%= shop.name %>" required maxlength="60"></div>
    <div class="field"><label for="k">Tipo</label><select id="k" name="kind"><% Object.entries(S.KINDS).forEach(([k, v]) => { %><option value="<%= k %>" <%= shop.kind === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  </div>
  <div class="field"><label for="tg">Frase corta</label><input id="tg" name="tagline" value="<%= shop.tagline %>" maxlength="100" placeholder="Ej.: Pan artesanal todos los días"></div>
  <div class="field"><label for="ds">Descripción</label><textarea id="ds" name="description" maxlength="600"><%= shop.description %></textarea></div>
  <div class="field"><label for="sl">Dirección web</label><div class="row" style="flex-wrap:nowrap"><span class="muted small nowrap"><%= baseUrl.replace(/^https?:\/\//, '') %>/t/</span><input id="sl" name="slug" value="<%= shop.slug %>" maxlength="40"></div><div class="hint">Si la cambias, el link anterior deja de funcionar.</div></div>
  <div class="upl">
    <label class="upbox up-logo" for="lg"><span class="lbl">Logo <small>(foto de perfil)</small></span><span class="pv"><% if (shop.logo) { %><img src="/m/<%= shop.logo %>" alt=""><% } else { %><span class="ph"><%- icon('image', 26) %></span><% } %></span><span class="act"><%- icon('image', 15) %> <%= shop.logo ? 'Cambiar logo' : 'Subir logo' %></span><span class="hint">Cuadrado, mínimo 400×400 px</span><input id="lg" type="file" name="logo" accept="image/jpeg,image/png,image/webp" data-compress="400" data-preview></label>
    <label class="upbox up-cover" for="cv"><span class="lbl">Portada <small>(banner de arriba)</small></span><span class="pv"><% if (shop.cover) { %><img src="/m/<%= shop.cover %>" alt=""><% } else { %><span class="ph"><%- icon('image', 26) %> Sin portada: se usa el color de tu marca</span><% } %></span><span class="act"><%- icon('image', 15) %> <%= shop.cover ? 'Cambiar portada' : 'Subir portada' %></span><span class="hint">Horizontal, recomendado 1600×500 px</span><input id="cv" type="file" name="cover" accept="image/jpeg,image/png,image/webp" data-compress="1400" data-preview></label>
  </div>
  <div class="row mt"><% if (shop.logo) { %><label class="check"><input type="checkbox" name="remove_logo" value="1"> Quitar logo</label><% } %><% if (shop.cover) { %><label class="check"><input type="checkbox" name="remove_cover" value="1"> Quitar portada</label><% } %></div>
  <div class="field mt"><label for="co">Color de tu marca</label><input id="co" type="color" name="color" value="<%= shop.color %>" style="max-width:120px"></div>
</div>
<div class="card"><h3>Contacto</h3>
  <div class="field"><label for="w">WhatsApp para pedidos</label><input id="w" name="whatsapp" value="<%= shop.whatsapp %>" required inputmode="numeric" maxlength="20"><div class="hint">Código del país + número, solo dígitos.</div></div>
  <div class="two">
    <div class="field"><label for="ms">Usuario de Facebook / Messenger <span class="muted">(opc.)</span></label><input id="ms" name="messenger" value="<%= shop.messenger %>" maxlength="60" placeholder="MiPaginaDeFacebook"><div class="hint">Activa el botón “Enviar por Messenger”.</div></div>
    <div class="field"><label for="ig">Instagram <span class="muted">(opc.)</span></label><input id="ig" name="instagram" value="<%= shop.instagram %>" maxlength="60" placeholder="minegocio"></div>
  </div>
  <div class="two">
    <div class="field"><label for="ad">Dirección <span class="muted">(opc.)</span></label><input id="ad" name="address" value="<%= shop.address %>" maxlength="150"></div>
    <div class="field"><label for="ci">Ciudad</label><input id="ci" name="city" value="<%= shop.city %>" maxlength="60"></div>
  </div>
  <div class="two">
    <div class="field"><label for="cu">Moneda</label><select id="cu" name="currency"><% Object.entries(S.CURRENCIES).forEach(([k, v]) => { %><option value="<%= k %>" <%= shop.currency === k ? 'selected' : '' %>><%= k %> · <%= v %></option><% }) %></select></div>
    <div class="field"><label for="tz">País / zona horaria</label><select id="tz" name="tz"><% Object.entries(S.TZ).forEach(([k, v]) => { %><option value="<%= k %>" <%= shop.tz === k ? 'selected' : '' %>><%= v %></option><% }) %></select></div>
  </div>
</div>
<div class="card"><h3>Horario de atención</h3><p class="small muted mb">Marca los días que abres. Si no marcas ninguno, no se muestra horario.</p>
  <% S.DAYS.forEach((d) => { const h = hours[d[0]]; %>
  <div class="hrs"><label><input type="checkbox" name="h_<%= d[0] %>_on" value="1" <%= h ? 'checked' : '' %>> <%= d[1] %></label><input type="time" name="h_<%= d[0] %>_o" value="<%= h ? h[0] : '08:00' %>" aria-label="Abre"><input type="time" name="h_<%= d[0] %>_c" value="<%= h ? h[1] : '18:00' %>" aria-label="Cierra"></div>
  <% }) %>
</div>
<div class="card"><h3>Pedidos y pagos</h3>
  <label class="switch"><span>Recibir pedidos ahora</span><input type="checkbox" name="accepting" value="1" <%= shop.accepting ? 'checked' : '' %>></label>
  <label class="switch"><span>Recoger en el local</span><input type="checkbox" name="pickup_on" value="1" <%= shop.pickup_on ? 'checked' : '' %>></label>
  <label class="switch"><span>Domicilio</span><input type="checkbox" name="delivery_on" value="1" <%= shop.delivery_on ? 'checked' : '' %>></label>
  <div class="two mt">
    <div class="field"><label for="df">Costo del domicilio (<%= shop.currency %>)</label><input id="df" name="delivery_fee" inputmode="decimal" value="<%= shop.delivery_fee_cents ? shop.delivery_fee_cents / 100 : '' %>" placeholder="0 = gratis"></div>
    <div class="field"><label for="mo">Pedido mínimo (<%= shop.currency %>)</label><input id="mo" name="min_order" inputmode="decimal" value="<%= shop.min_order_cents ? shop.min_order_cents / 100 : '' %>" placeholder="Opcional"></div>
  </div>
  <div class="field"><label for="zn">Domicilio por zonas <span class="muted">(opcional)</span></label><textarea id="zn" name="zones" rows="4" maxlength="3000" placeholder="El Poblado | 5000&#10;Laureles | 6000&#10;Envigado | 8000"><%= shop.zones %></textarea><div class="hint">Una zona por línea: <b>Barrio o sector | precio</b>. Si escribes zonas, el cliente elige la suya y se cobra ese valor en vez del costo fijo.</div></div>
  <div class="field"><label for="pi">¿Cómo te pagan?</label><textarea id="pi" name="payment_info" maxlength="400" placeholder="Una forma de pago por línea. Ej.:&#10;Nequi: 300 123 4567&#10;Bancolombia ahorros: 123-456789-00&#10;Efectivo al recibir"><%= shop.payment_info %></textarea><div class="hint">Una forma de pago por línea. El cliente elige una al pedir y se la mostramos con botón para copiar. El dinero va directo a ti.</div></div>
</div>
<div class="card" id="agenda"><h3>Agenda de citas</h3>
  <p class="small muted mb">Para negocios de servicios (peluquería, uñas, spa, consultorio, taller…). Tus clientes eligen el día y la hora libre y la reserva te llega a WhatsApp. Usa tu <b>horario de atención</b> (arriba) y la <b>duración</b> que pongas a cada servicio.</p>
  <label class="switch"><span>Recibir reservas en línea</span><input type="checkbox" name="agenda_on" value="1" <%= shop.agenda_on ? 'checked' : '' %>></label>
  <div class="three mt">
    <div class="field"><label for="ags">Turnos cada</label><select id="ags" name="agenda_step"><% [15, 20, 30, 45, 60].forEach((m) => { %><option value="<%= m %>" <%= shop.agenda_step === m ? 'selected' : '' %>><%= m %> min</option><% }) %></select></div>
    <div class="field"><label for="agd">Reservas hasta</label><select id="agd" name="agenda_days"><% [7, 14, 30, 60].forEach((d) => { %><option value="<%= d %>" <%= shop.agenda_days === d ? 'selected' : '' %>><%= d %> días</option><% }) %></select></div>
    <div class="field"><label for="agc">Citas a la vez</label><input id="agc" name="agenda_cap" type="number" min="1" max="20" value="<%= shop.agenda_cap || 1 %>"><div class="hint">Cuántas personas atienden al mismo tiempo.</div></div>
  </div>
  <p class="small muted">Luego, en <b>Productos → Editar</b>, pon la <b>duración</b> de cada servicio que se pueda reservar.</p>
</div>
<div class="card"><h3>Estilo del catálogo</h3>
  <div class="seg2">
    <label><input type="radio" name="layout" value="list" <%= shop.layout !== 'grid' ? 'checked' : '' %>><span class="lay lay-list"><i></i><i></i><i></i></span><b>Lista</b><small>Foto pequeña al lado. Ideal para comida y menús.</small></label>
    <label><input type="radio" name="layout" value="grid" <%= shop.layout === 'grid' ? 'checked' : '' %>><span class="lay lay-grid"><i></i><i></i><i></i><i></i></span><b>Cuadrícula</b><small>Fotos grandes. Ideal para ropa, accesorios y tiendas.</small></label>
  </div>
</div>
<div class="card" id="seo"><h3>Al compartir y en Google</h3>
  <p class="small muted mb">Así se ve tu tienda cuando compartes el link en WhatsApp, Facebook o Instagram, y cuando alguien la encuentra en Google.</p>
  <% const sImg = shop.seo_image || shop.cover || shop.logo, sTitle = shop.seo_title || shop.name, sDesc = shop.seo_desc || shop.tagline || shop.description || ('Catálogo de ' + shop.name + '. Haz tu pedido por WhatsApp.'); %>
  <div class="seo-grid" style="margin:0">
    <div>
      <label class="upbox up-share" for="ssi"><span class="lbl">Imagen al compartir <small>(1200 × 630 px)</small></span><span class="pv"><% if (shop.seo_image) { %><img src="/m/<%= shop.seo_image %>" alt=""><% } else { %><span class="ph"><%- icon('image', 24) %> Sin imagen propia: se usa tu <%= shop.cover ? 'portada' : (shop.logo ? 'logo' : 'nombre') %></span><% } %></span>
        <span class="act"><%- icon('image', 15) %> <%= shop.seo_image ? 'Cambiar imagen' : 'Subir imagen' %></span><input id="ssi" type="file" name="seo_image" accept="image/jpeg,image/png,image/webp" data-compress="1600" data-preview></label>
      <% if (shop.seo_image) { %><label class="check mt"><input type="checkbox" name="remove_seo_image" value="1"> Quitar la imagen</label><% } %>
      <div class="field mt"><label for="stt">Título <span class="muted">(máx. 60)</span></label><input id="stt" name="seo_title" maxlength="70" value="<%= shop.seo_title %>" placeholder="<%= shop.name %>" data-bind-src="stitle" data-count="60"><div class="hint"><span data-count-for="stt"></span> Vacío = el nombre de tu negocio.</div></div>
      <div class="field"><label for="sdd">Descripción <span class="muted">(máx. 160)</span></label><textarea id="sdd" name="seo_desc" maxlength="160" rows="3" placeholder="Ej.: Pan artesanal y tortas por encargo en Medellín. Pide por WhatsApp y recibe a domicilio." data-bind-src="sdesc" data-count="160"><%= shop.seo_desc %></textarea><div class="hint"><span data-count-for="sdd"></span> Vacío = tu frase corta.</div></div>
      <div class="field"><label for="skk">Palabras clave <span class="muted">(separadas por coma)</span></label><input id="skk" name="seo_keywords" maxlength="300" value="<%= shop.seo_keywords %>" placeholder="panadería medellín, tortas por encargo, pan artesanal"></div>
    </div>
    <div>
      <p class="lbl">Vista previa en WhatsApp</p>
      <div class="pv-wa"><div class="pv-wa-img"><% if (sImg) { %><img src="/m/<%= sImg %>" alt=""><% } else { %><span><%= shop.name %></span><% } %></div><div class="pv-wa-tx"><b data-bind="stitle"><%= sTitle %></b><span data-bind="sdesc"><%= sDesc %></span><small><%= baseUrl.replace(/^https?:\/\//, '') %></small></div></div>
      <p class="lbl mt">En Google</p>
      <div class="pv-g"><small><%= baseUrl.replace(/^https?:\/\//, '') %> › t › <%= shop.slug %></small><b data-bind="stitle"><%= sTitle %></b><span data-bind="sdesc"><%= sDesc %></span></div>
      <p class="hint mt">Cada producto también tiene su propia vista previa con su foto y precio cuando compartes su link.</p>
    </div>
  </div>
</div>
<div class="card"><h3>Publicidad y medición <span class="muted small">(opcional)</span></h3>
  <p class="small muted mb">Para medir tus anuncios de Facebook, Instagram y Google. Si no haces publicidad, déjalo vacío.</p>
  <div class="two">
    <div class="field"><label for="fp">ID del píxel de Meta (Facebook)</label><input id="fp" name="fb_pixel" value="<%= shop.fb_pixel %>" inputmode="numeric" maxlength="20" placeholder="Ej.: 123456789012345"><div class="hint">Administrador de eventos de Meta → tu píxel → número de ID.</div></div>
    <div class="field"><label for="ga">ID de Google Analytics</label><input id="ga" name="ga_id" value="<%= shop.ga_id %>" maxlength="20" placeholder="Ej.: G-ABC123XYZ"><div class="hint">Analytics → Administrar → Flujos de datos → ID de medición.</div></div>
  </div>
  <p class="small muted">Se registran: visita al catálogo, producto agregado al carrito y pedido enviado.</p>
</div>
<div class="card" id="dominio"><h3>Dominio propio</h3>
  <% if (can('domain')) { %>
  <div class="field"><label for="dm">Tu dominio</label><input id="dm" name="domain" value="<%= shop.domain || '' %>" maxlength="80" placeholder="www.tunegocio.com"><div class="hint">Así tu catálogo abre en tu propia dirección, sin <i>/t/<%= shop.slug %></i>.</div></div>
  <ol class="small muted" style="padding-left:20px;line-height:1.8"><li>Compra tu dominio (GoDaddy, Namecheap, Hostinger…).</li><li>En la zona DNS crea un registro <b>A</b> con nombre <b>@</b> y otro con nombre <b>www</b>, ambos apuntando a <b><%= (process.env.SERVER_IP || baseUrl.replace(/^https?:\/\//, '').split(':')[0]) %></b>.</li><li>Escribe aquí el dominio y guarda. Avísanos para activar el certificado de seguridad (candado).</li></ol>
  <% } else { %><p class="small muted">Disponible en el plan Pro: tu catálogo en <b>www.tunegocio.com</b>. <a href="/panel/plan">Ver planes</a></p><% } %>
</div>
<% const pms = S.payMethods(shop); %>
<div class="card"><h3>Respuesta instantánea en WhatsApp</h3>
  <p class="small muted mb">La web no puede escribir por ti en WhatsApp, pero <b>WhatsApp Business (gratis)</b> sí responde solo. Copia este texto y pégalo como <b>Mensaje de bienvenida</b>: cada cliente que te escriba recibe al instante tus datos de pago.</p>
  <textarea readonly rows="7" id="autoreply" aria-label="Mensaje de bienvenida"><%= '¡Hola! 👋 Gracias por escribir a ' + shop.name + '. Ya recibimos tu pedido.' + (pms.length ? '\n\nPuedes pagar así:\n' + pms.map((m) => '• ' + m.text).join('\n') : '') + '\n\nCuando pagues, envíanos el comprobante por aquí y confirmamos tu pedido ✅' %></textarea>
  <div class="row mt"><button class="btn btn-p btn-sm" type="button" data-copy-from="autoreply"><%- icon('copy', 15) %> Copiar mensaje</button></div>
  <ol class="small muted" style="padding-left:20px;line-height:1.8;margin-top:12px"><li>Abre <b>WhatsApp Business</b> → Más opciones → <b>Herramientas para la empresa</b>.</li><li>Entra a <b>Mensaje de bienvenida</b> y actívalo.</li><li>Pega el texto y elige <b>Todos</b> como destinatarios.</li></ol>
</div>
<button class="btn btn-p btn-lg">Guardar cambios</button>
</form>
<%- include('../partials/foot') %>
