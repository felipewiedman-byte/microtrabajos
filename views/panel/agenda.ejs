<%- include('../partials/head') %>
<div class="page-h"><h1>Agenda</h1>
  <div class="row segs"><a class="btn btn-sm <%= past ? '' : 'btn-d' %>" href="/panel/agenda">Próximas</a><a class="btn btn-sm <%= past ? 'btn-d' : '' %>" href="/panel/agenda?ver=pasadas">Pasadas</a></div></div>
<% if (!shop.agenda_on) { %><div class="flash error">La agenda está apagada: los clientes no pueden reservar. Actívala en <a href="/panel/negocio#agenda"><b>Mi negocio</b></a>.</div><% } %>
<% if (!rows.length) { %><div class="card empty"><%- icon('calendar', 34) %><h3><%= past ? 'No hay citas pasadas' : 'No tienes citas próximas' %></h3><p class="small">Pon la <b>duración</b> a tus servicios (Productos → Editar) para que aparezca “Reservar” en tu catálogo.</p></div><% } %>
<% let lastDay = ''; rows.forEach((a) => { const st = { pending: ['Por confirmar', 'warn'], confirmed: ['Confirmada', 'ok'], done: ['Atendida', ''], cancelled: ['Cancelada', 'bad'] }[a.status] || ['', ''];
   const nm = a.customer_name.split(' ')[0], when = A.fmtDay(a.day) + ' a las ' + A.label(a.start_min);
   const msg = a.status === 'cancelled' ? `Hola ${nm}, te escribimos de ${shop.name} por tu reserva ${a.code}.` : a.status === 'pending' ? `¡Hola ${nm}! ✅ Tu cita de ${a.service} en ${shop.name} quedó confirmada para el ${when}. Te esperamos.` : `Hola ${nm} 👋 Te recordamos tu cita de ${a.service} en ${shop.name} el ${when}.`; %>
  <% if (a.day !== lastDay) { lastDay = a.day; %><h3 class="sec-h"><%= a.day === today ? 'Hoy · ' : a.day === tomorrow ? 'Mañana · ' : '' %><%= A.fmtDay(a.day) %></h3><% } %>
  <div class="ord appt<%= a.status === 'cancelled' ? ' off' : '' %>">
    <div class="appt-t"><b><%= A.label(a.start_min) %></b><small><%= A.label(a.end_min) %></small></div>
    <div class="appt-b"><div class="row between"><div><b><%= a.service %></b> · <%= a.customer_name %> <span class="small muted">· <%= a.code %></span></div><span class="badge <%= st[1] %>"><%= st[0] %></span></div>
      <% if (a.note) { %><div class="small muted mt">📝 <%= a.note %></div><% } %>
      <div class="row mt" style="gap:6px">
        <% if (a.customer_phone) { %><a class="btn btn-sm btn-wa" target="_blank" rel="noopener" href="<%= S.waLink(a.customer_phone, msg) %>"><%- icon('chat', 15) %> <%= a.status === 'pending' ? 'Confirmar por WhatsApp' : 'Escribir' %></a><% } %>
        <form method="post" action="/panel/agenda/<%= a.id %>" class="row" style="gap:6px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/panel/agenda<%= past ? '?ver=pasadas' : '' %>">
          <% if (a.status === 'pending') { %><button class="btn btn-sm btn-p" name="estado" value="confirmed">Marcar confirmada</button><% } %>
          <% if (a.status === 'confirmed') { %><button class="btn btn-sm btn-p" name="estado" value="done">Atendida</button><% } %>
          <% if (a.status !== 'cancelled' && a.status !== 'done') { %><button class="btn btn-sm btn-danger" name="estado" value="cancelled" data-confirm="¿Cancelar esta cita? El horario queda libre.">Cancelar</button><% } %>
          <% if (a.status === 'cancelled') { %><button class="btn btn-sm" name="estado" value="pending">Reactivar</button><% } %>
        </form>
      </div></div>
  </div>
<% }) %>
<%- include('../partials/foot') %>
