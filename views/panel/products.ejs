<%- include('../partials/head') %>
<% const nn = shop.kind === 'servicios' ? ['servicio', 'servicios'] : ['producto', 'productos']; %>
<div class="page-h"><h1><%= nn[1].charAt(0).toUpperCase() + nn[1].slice(1) %> <span class="small muted">· <%= count %> de <%= limit %></span></h1>
  <% if (count < limit) { %><a class="btn btn-p" href="/panel/productos/nuevo"><%- icon('plus', 16) %> Agregar</a><% } else { %><a class="btn" href="/panel/plan">Mejorar plan</a><% } %></div>
<% if (count >= limit) { %><div class="flash error">Llegaste al límite de tu plan. Mejora tu plan para agregar más.</div><% } %>
<div class="card">
  <form method="get" class="row" style="margin-bottom:6px"><input name="q" value="<%= q %>" placeholder="Buscar…" style="max-width:300px" aria-label="Buscar"><button class="btn">Buscar</button><% if (q) { %><a class="btn btn-g" href="/panel/productos">Limpiar</a><% } %></form>
  <% if (!rows.length) { %><div class="empty"><%- icon('box', 34) %><h3><%= q ? 'Sin resultados' : 'Aún no tienes ' + nn[1] %></h3><% if (!q) { %><p class="small">Agrega el primero con foto y precio.</p><a class="btn btn-p mt" href="/panel/productos/nuevo">Agregar <%= nn[0] %></a><% } %></div><% } %>
  <% rows.forEach((p) => { %>
  <div class="prow">
    <% if (p.image) { %><img class="th" src="/m/<%= p.image %>" alt="" width="56" height="56" loading="lazy"><% } else { %><div class="th"><%- icon('image', 22) %></div><% } %>
    <div class="nm"><b><%= p.name %></b><span class="small muted"><%= money(p.price_cents, shop.currency) %><%= p.cat ? ' · ' + p.cat : '' %><%= p.stock !== null ? ' · Stock ' + p.stock : '' %></span></div>
    <% if (!p.active) { %><span class="badge">Oculto</span><% } else if (p.stock !== null && p.stock <= 0) { %><span class="badge warn">Agotado</span><% } else if (p.featured) { %><span class="badge accent">Destacado</span><% } %>
    <form method="post" action="/panel/productos/<%= p.id %>/accion" class="row" style="gap:4px"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <a class="btn btn-sm btn-g" href="/panel/productos/<%= p.id %>/editar" title="Editar"><%- icon('edit', 16) %></a>
      <button class="btn btn-sm btn-g" name="accion" value="toggle" title="<%= p.active ? 'Ocultar' : 'Mostrar' %>"><%- icon('eye', 16) %></button>
      <button class="btn btn-sm btn-g btn-danger" name="accion" value="delete" title="Eliminar" data-confirm="¿Eliminar &quot;<%= p.name %>&quot;? No se puede deshacer."><%- icon('trash', 16) %></button>
    </form>
  </div>
  <% }) %>
  <% if (pages > 1) { %><div class="pager"><% if (page > 1) { %><a class="btn btn-sm" href="?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">← Anterior</a><% } %><span class="small muted">Página <%= page %> de <%= pages %></span><% if (page < pages) { %><a class="btn btn-sm" href="?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>">Siguiente →</a><% } %></div><% } %>
</div>
<div class="card" id="importar">
  <h3>Cargar muchos productos a la vez</h3><p class="small muted mb">Llena la plantilla en Excel o Google Sheets, guárdala como <b>CSV</b> y súbela. Si un producto ya existe (mismo nombre), se actualiza. Las fotos se agregan después desde “Editar”.</p>
  <form method="post" action="/panel/productos/importar" enctype="multipart/form-data" class="imp"><input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="imp-a"><a class="btn btn-sm" href="/panel/productos/plantilla.csv"><%- icon('download', 15) %> Descargar plantilla</a><% if (count) { %><a class="btn btn-sm" href="/panel/productos/exportar.csv"><%- icon('download', 15) %> Exportar productos</a><% } %></div>
    <div class="imp-b"><input type="file" name="archivo" accept=".csv,text/csv" required aria-label="Archivo CSV"><button class="btn btn-p">Subir archivo</button></div>
  </form>
  <details class="small muted mt"><summary>¿Cómo guardo el archivo como CSV?</summary><p class="mt">En <b>Excel</b>: Archivo → Guardar como → tipo “CSV UTF-8 (delimitado por comas)”. En <b>Google Sheets</b>: Archivo → Descargar → “Valores separados por comas (.csv)”. Columnas: nombre, precio, descripcion, categoria, precio_anterior, inventario, opciones (separa grupos con “|”), destacado (si/no), visible (si/no).</p></details>
</div>
<div class="card" id="categorias">
  <h3>Categorías</h3><p class="small muted mb">Agrupa tu catálogo (ej.: Panes, Tortas, Bebidas). Los clientes filtran por ellas.</p>
  <% cats.forEach((c) => { %>
  <form method="post" action="/panel/categorias" class="row mb" style="gap:8px;flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>">
    <input name="name" value="<%= c.name %>" maxlength="40" aria-label="Nombre de categoría"><span class="small muted nowrap"><%= c.n %> uds.</span>
    <button class="btn btn-sm" name="accion" value="rename">Guardar</button><button class="btn btn-sm btn-danger" name="accion" value="delete" data-confirm="¿Eliminar la categoría? Los productos se conservan sin categoría."><%- icon('trash', 15) %></button>
  </form><% }) %>
  <form method="post" action="/panel/categorias" class="row" style="gap:8px;flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="accion" value="add"><input name="name" placeholder="Nueva categoría" maxlength="40" required><button class="btn btn-p nowrap">Crear</button></form>
</div>
<%- include('../partials/foot') %>
