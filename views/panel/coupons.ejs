<%- include('../partials/head') %>
<div class="page-h"><h1>Cupones</h1></div>
<% if (!can('coupons')) { %>
<div class="lock"><%- icon('lock', 26) %><h3 class="mt">Cupones de descuento</h3><p class="small mt">Crea códigos como “BIENVENIDO10” para atraer y recompensar clientes. Disponible desde el plan Básico.</p><a class="btn btn-p mt" href="/panel/plan">Ver planes</a></div>
<% } else { %>
<div class="card">
  <h3>Nuevo cupón</h3>
  <form method="post" action="/panel/cupones"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="accion" value="add">
    <div class="two">
      <div class="field"><label for="c">Código</label><input id="c" name="code" required maxlength="20" placeholder="BIENVENIDO10" style="text-transform:uppercase"></div>
      <div class="field"><label for="k">Tipo</label><select id="k" name="kind"><option value="pct">Porcentaje (%)</option><option value="fixed">Valor fijo (<%= shop.currency %>)</option></select></div>
    </div>
    <div class="three">
      <div class="field"><label for="v">Valor</label><input id="v" name="value" required inputmode="decimal" placeholder="10"></div>
      <div class="field"><label for="m">Compra mínima <span class="muted">(opc.)</span></label><input id="m" name="min" inputmode="decimal"></div>
      <div class="field"><label for="u">Usos máximos <span class="muted">(0 = ilimitado)</span></label><input id="u" name="max_uses" inputmode="numeric" value="0"></div>
    </div>
    <button class="btn btn-p">Crear cupón</button>
  </form>
</div>
<div class="card">
  <h3>Tus cupones</h3>
  <% if (!rows.length) { %><p class="muted small">Aún no tienes cupones.</p><% } %>
  <% rows.forEach((c) => { %><div class="prow"><div class="nm"><b><%= c.code %></b><span class="small muted"><%= c.kind === 'pct' ? c.value + '% de descuento' : money(c.value, shop.currency) + ' de descuento' %><%= c.min_cents ? ' · desde ' + money(c.min_cents, shop.currency) : '' %> · usado <%= c.uses %><%= c.max_uses ? ' de ' + c.max_uses : '' %> veces</span></div>
    <span class="badge <%= c.active ? 'ok' : '' %>"><%= c.active ? 'Activo' : 'Pausado' %></span>
    <form method="post" action="/panel/cupones" class="row" style="gap:4px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="id" value="<%= c.id %>"><button class="btn btn-sm" name="accion" value="toggle"><%= c.active ? 'Pausar' : 'Activar' %></button><button class="btn btn-sm btn-g btn-danger" name="accion" value="delete" data-confirm="¿Eliminar el cupón?"><%- icon('trash', 15) %></button></form></div><% }) %>
</div>
<% } %>
<%- include('../partials/foot') %>
