<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Mercado a domicilio</h1><p>Arma tu mercado, compara la canasta completa en cada supermercado de tu ciudad y recíbelo en casa. Pagas protegido y solo el valor real del recibo.</p></div>
  <% if (!city) { %><div class="alert alert-warn mb"><%- icon('mappin', 16) %><span>Elige tu ciudad en <strong>“Tu ciudad”</strong> (arriba a la izquierda) para ver los supermercados disponibles.</span></div><% } %>
  <div class="gx-chains"><span class="muted small">Supermercados en <%= city || 'tu ciudad' %>:</span><% chains.forEach(function(c){ %><span class="gx-chip" style="--cc:<%= c.color %>"><%= c.name %></span><% }) %></div>
  <div class="layout-left mt">
    <aside class="card side sticky">
      <h4>Pasillos</h4>
      <a href="/mercado" class="<%= !cat ? 'active' : '' %>"><%- icon('grid', 15) %> Todo</a>
      <% categories.forEach(function(c){ %><a href="/mercado?cat=<%= encodeURIComponent(c.category) %>" class="<%= cat === c.category ? 'active' : '' %>"><%- icon('cart', 15) %> <%= c.category %> <span class="muted small">(<%= c.n %>)</span></a><% }) %>
    </aside>
    <div>
      <form class="row mb" action="/mercado"><input type="search" name="q" value="<%= q %>" placeholder="Buscar producto: arroz, leche, huevos…" style="flex:1;min-width:200px"><% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %><button class="btn btn-primary">Buscar</button></form>
      <form method="post" action="/mercado/comparar" id="gxCart"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (!products.length) { %><div class="empty">No encontramos productos.</div><% } %>
        <div class="gx-grid">
          <% products.forEach(function(p){ %>
            <div class="gx-item">
              <span class="gx-cat"><%= p.category %></span>
              <strong><%= p.name %></strong>
              <span class="gx-from"><%= p.min_price ? 'Desde ' + cop(p.min_price) : 'Precio por confirmar' %></span>
              <div class="gx-qty"><button type="button" data-step="-1" aria-label="Menos">−</button><input type="number" name="q<%= p.id %>" min="0" max="50" value="0" inputmode="numeric" aria-label="Cantidad"><button type="button" data-step="1" aria-label="Más">+</button></div>
            </div>
          <% }) %>
        </div>
        <div class="gx-bar"><span><b data-gx-count>0</b> productos en tu mercado</span><button class="btn btn-primary" data-gx-go disabled>Comparar supermercados <%- icon('arrow', 14) %></button></div>
      </form>
      <p class="muted small mt">Los precios son de referencia y se actualizan con cada recibo de compra. Pagas una reserva y al final se cobra solo lo que diga el recibo; el sobrante se te devuelve.</p>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
