<%- include('partials/head') %>
<div class="container narrow">
  <div class="page-head"><h1>Mensajes</h1><p>Toda la comunicación ocurre aquí, protegida y con historial.</p></div>
  <h2 class="section-label">Conversaciones antes de contratar</h2>
  <% if (!convs.length) { %><div class="empty">Sin conversaciones. Usa “Enviar mensaje” en un servicio o perfil.</div><% } else { %>
  <div class="card" style="padding:8px 20px"><% convs.forEach(function(t){ %><a class="list-row" href="/conversacion/<%= t.id %>#chat"><div class="row" style="flex-wrap:nowrap;min-width:0"><span class="avatar sm"><%= t.other.charAt(0) %></span><div style="min-width:0"><strong class="small"><%= publicName(t.other) %></strong><br><span class="muted small"><%= /^OFERTA#/.test(t.last || '') ? 'Oferta personalizada enviada' : (t.last || '').slice(0, 90) %></span></div></div><span class="muted small"><%= ago(t.last_at) %></span></a><% }) %></div><% } %>
  <h2 class="section-label mt">Chats de trabajos contratados</h2>
  <% if (!threads.length) { %><div class="empty">Aún no tienes trabajos contratados.</div><% } else { %>
  <div class="card" style="padding:8px 20px">
    <% threads.forEach(function(t){ %><a class="list-row" href="/pedidos/<%= t.id %>#chat"><div class="row" style="flex-wrap:nowrap;min-width:0"><span class="avatar sm"><%= t.other.charAt(0) %></span><div style="min-width:0"><strong class="small"><%= publicName(t.other) %></strong> <span class="muted small">· <%= t.title %></span><br><span class="muted small"><%= (t.last || 'Sin mensajes').slice(0, 90) %></span></div></div><span class="muted small"><%= t.at ? ago(t.at) : '' %></span></a><% }) %>
  </div><% } %>
</div>
<%- include('partials/foot') %>
