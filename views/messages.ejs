<%- include('partials/head') %>
<div class="container">
  <div class="page-head"><h1>Mensajes</h1><p>El chat privado se abre al contratar. Antes de contratar, las dudas se resuelven con preguntas públicas.</p></div>
  <div class="grid g2">
    <div class="card"><div class="card-head"><h3><%- icon('chat', 16) %> Chats de trabajos contratados</h3></div>
      <% if (!threads.length) { %><p class="muted small">Aún no tienes trabajos contratados.</p><% } %>
      <% threads.forEach(function(t){ %><a class="list-row" href="/pedidos/<%= t.id %>#chat"><div class="row" style="flex-wrap:nowrap;min-width:0"><span class="avatar sm"><%= t.other.charAt(0) %></span><div style="min-width:0"><strong class="small"><%= publicName(t.other) %></strong> <span class="muted small">· <%= t.title %></span><br><span class="muted small"><%= (t.last || 'Sin mensajes').slice(0, 80) %></span></div></div><span class="muted small"><%= t.at ? ago(t.at) : '' %></span></a><% }) %>
    </div>
    <div class="card"><div class="card-head"><h3><%- icon('question', 16) %> Preguntas recientes</h3></div>
      <% if (!questions.length) { %><p class="muted small">Sin preguntas.</p><% } %>
      <% questions.forEach(function(q){ %><a class="list-row" href="/<%= q.target_type === 'gig' ? 'servicios' : 'tareas' %>/<%= q.target_id %>#preguntas"><span class="small"><strong><%= q.title %></strong><br><span class="muted"><%= q.text.slice(0, 80) %></span></span><%- q.answer ? '<span class="badge ok">Respondida</span>' : '<span class="badge warn">Pendiente</span>' %></a><% }) %>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
