<%# Selector mundial de ciudades. Parámetros: mode ('field' | 'nav'), fname (campo oculto, 'city'), sname (firma, 'city_sig'; '' = sin firma), value, back, legacy (lista noscript) %>
<%
  var _mode = typeof mode !== 'undefined' ? mode : 'field';
  var _f = typeof fname !== 'undefined' ? fname : 'city';
  var _s = typeof sname !== 'undefined' ? sname : 'city_sig';
  var _v = typeof value !== 'undefined' && value ? String(value) : '';
  var _sig = _v ? citySig(_v) : '';
%>
<div class="cityp" data-cityp data-mode="<%= _mode %>" data-back="<%= typeof back !== 'undefined' ? back : '/' %>">
  <div class="cityp-row">
    <input type="search" class="cityp-q" placeholder="Escribe tu ciudad (cualquier país)…" autocomplete="off" maxlength="80" aria-label="Buscar ciudad" aria-autocomplete="list" value="<%= _v %>">
    <button type="button" class="btn btn-ghost cityp-gps" title="Detectar mi ciudad con el GPS de este dispositivo"><%- icon('mappin', 14) %> <span>Usar mi ubicación</span></button>
  </div>
  <% if (_mode === 'field') { %>
    <input type="hidden" data-f="city" name="<%= _f %>" value="<%= _v %>">
    <% if (_s) { %><input type="hidden" data-f="sig" name="<%= _s %>" value="<%= _sig %>"><% } %>
  <% } %>
  <ul class="cityp-list" role="listbox" hidden></ul>
  <p class="cityp-msg small muted" aria-live="polite"></p>
  <% if (_mode === 'field' && typeof legacy !== 'undefined') { %>
    <noscript><select name="<%= _f %>"><option value="">Seleccione…</option><% CITIES.forEach(function(c){ %><option <%= _v === c ? 'selected' : '' %>><%= c %></option><% }) %></select></noscript>
  <% } %>
</div>
