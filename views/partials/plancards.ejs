<%
const P = Plans.currency(), mpOn = settings.mp_enabled === '1';
const shown = Plans.list().filter((p) => p.active && (p.key !== 'trial' || p.days > 0));
const common = BL.lines(settings.plans_common);
const feats = Object.keys(Plans.FEATURES).filter((k) => (k !== 'payments' || mpOn) && shown.some((p) => p.features[k]));
%>
<div class="plans n<%= Math.min(3, Math.max(1, shown.length)) %>">
<% shown.forEach((c) => { %>
  <div class="plan <%= c.hot ? 'hot' : '' %>">
    <h3><%= c.name %></h3><p class="small muted"><%= c.descr %></p>
    <div class="pr"><%= c.price > 0 ? '$' + c.price : '$0' %> <small><%= c.price > 0 ? P + ' / mes' : c.days + ' días' %></small></div>
    <ul>
      <li><%- icon('check', 16) %> Hasta <%= c.product_limit %> productos</li>
      <% common.forEach((x) => { %><li><%- icon('check', 16) %> <%= x %></li><% }) %>
      <% feats.forEach((k) => { %><li class="<%= c.features[k] ? '' : 'no' %>"><%- icon(c.features[k] ? 'check' : 'x', 16) %> <%= Plans.FEATURES[k] %></li><% }) %>
      <% BL.lines(c.extra).forEach((x) => { %><li><%- icon('check', 16) %> <%= x %></li><% }) %>
    </ul>
    <a class="btn <%= c.hot ? 'btn-p' : '' %> btn-block" href="/registro"><%= c.cta || 'Empezar' %></a>
  </div>
<% }) %>
</div>
