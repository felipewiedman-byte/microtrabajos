<a class="task" href="/servicios/<%= g.id %>">
  <div class="row between"><span class="kind kind-gig">Servicio · <%= g.cat_name %></span><span class="muted small"><%- icon('clock', 13) %> <%= hours(g.delivery_hours) %></span></div>
  <h3><%= g.title %></h3>
  <div class="row" style="gap:8px"><span class="avatar sm"><%= g.worker_name.charAt(0) %></span><span class="small"><strong><%= publicName(g.worker_name) %></strong><br><span class="muted"><% if (g.rating) { %><%- stars(g.rating) %> <%= g.rating %> (<%= g.reviews %>)<% } else { %>Nuevo<% } %></span></span></div>
  <div class="foot"><span class="muted small">Precio fijo</span><span class="price right"><%= money(g.price_cents) %><span class="local"><%= local(g.price_cents) %></span></span></div>
</a>
