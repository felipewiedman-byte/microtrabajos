<a class="tk" href="/servicios/<%= g.id %>">
  <div class="tk-top"><span class="tk-cat"><%- catIcon(g.cat_slug, 13) %><span><%= g.cat_name %></span></span><span class="tk-flag tk-fixed">Precio fijo</span></div>
  <h3 class="tk-title"><%= g.title %></h3>
  <p class="tk-desc"><%= g.description %></p>
  <ul class="tk-info">
    <li><span class="tk-av"><%= g.worker_name.charAt(0) %></span> <%= publicName(g.worker_name) %></li>
    <li><%- icon('clock', 14) %> <%= hours(g.delivery_hours) %></li>
    <li><%- icon('star', 14) %> <%= g.rating ? g.rating + ' (' + g.reviews + ')' : 'Nuevo' %></li>
  </ul>
  <div class="tk-foot">
    <div class="tk-price"><strong><%= money(g.price_cents).replace(' USD', '') %> <em>USD</em></strong><small><%= local(g.price_cents) %></small></div>
    <span class="tk-btn">Contratar <%- icon('arrow', 14) %></span>
  </div>
</a>
