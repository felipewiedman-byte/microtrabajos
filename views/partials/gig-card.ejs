<a class="item" href="/servicios/<%= g.id %>">
  <div class="item-top"><span class="item-ico"><%- catIcon(g.cat_slug, 16) %></span><span class="item-cat"><%= g.cat_name %></span></div>
  <h3 class="item-title"><%= g.title %></h3>
  <div class="item-meta"><span class="avatar xs"><%= g.worker_name.charAt(0) %></span><span><strong><%= publicName(g.worker_name) %></strong></span><span><% if (g.rating) { %><%- icon('star', 13) %> <%= g.rating %> (<%= g.reviews %>)<% } else { %>Nuevo<% } %></span><span><%- icon('clock', 13) %> <%= hours(g.delivery_hours) %></span></div>
  <div class="item-foot"><div><span class="item-price"><%= money(g.price_cents) %></span><span class="item-local"><%= local(g.price_cents) %></span></div><span class="item-cta">Contratar</span></div>
</a>
