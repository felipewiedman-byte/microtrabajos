<a class="item2" href="/servicios/<%= g.id %>">
  <div class="i2-head i2-gig"><%- catIcon(g.cat_slug, 15) %><span><%= g.cat_name %></span></div>
  <div class="i2-body">
    <h3 class="i2-title"><%= g.title %></h3>
    <div class="i2-boxes">
      <div class="i2-price"><small>Precio fijo</small><strong><%= money(g.price_cents) %></strong><span><%= local(g.price_cents) %></span></div>
      <div class="i2-time"><small>Entrega</small><strong><%- icon('clock', 16) %> <%= hours(g.delivery_hours) %></strong><span><%= g.revisions %> correcciones</span></div>
    </div>
    <div class="i2-foot"><span><b class="i2-av"><%= g.worker_name.charAt(0) %></b> <%= publicName(g.worker_name) %> · <% if (g.rating) { %><%= g.rating %> ★<% } else { %>Nuevo<% } %></span><span class="i2-btn">Contratar</span></div>
  </div>
</a>
