<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= settings.site_name %></title>
<meta name="description" content="<%= settings.site_name %>: ayuda remunerada entre personas. Publica lo que necesitas, contrata y paga protegido, o gana dinero ayudando.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=<%= encodeURIComponent(settings.font || 'Inter') %>:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/styles.css?v=<%= assetV %>">
<% if (settings.favicon) { %><link rel="icon" href="/media/<%= settings.favicon %>"><% } else { %><link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='<%= encodeURIComponent(settings.color_brand) %>'/><text x='16' y='22' font-family='Arial' font-weight='700' font-size='16' fill='white' text-anchor='middle'><%= String(settings.site_name).charAt(0) %></text></svg>"><% } %>
<style>:root{--brand:<%= settings.color_brand %>;--brand-dark:color-mix(in srgb,<%= settings.color_brand %> 82%,black);--brand-soft:color-mix(in srgb,<%= settings.color_brand %> 8%,white);--c-accent:<%= settings.color_accent %>;--c-success:<%= settings.color_success %>;--c-warning:<%= settings.color_warning %>;--navy:<%= settings.color_dark %>;--hero:<%= settings.color_hero %>}body{font-family:'<%= settings.font %>',Inter,system-ui,sans-serif}</style>
</head>
<body>
<% if (String(settings.show_topbar) !== '0') { %>
<div class="infobar"><div class="container infobar-in">
  <div class="row" style="gap:18px">
    <% if (settings.contact_hours) { %><span><%- icon('clock', 13) %> <%= settings.contact_hours %></span><% } %>
    <% if (settings.contact_email) { %><a href="mailto:<%= settings.contact_email %>"><%- icon('mail', 13) %> <%= settings.contact_email %></a><% } %>
  </div>
  <div class="row" style="gap:14px"><%- include('social') %><% if (settings.contact_phone) { %><span class="infobar-sep"></span><span><%- icon('phone', 13) %> <%= settings.contact_phone %></span><% } %><% if (!settings.contact_phone && !settings.contact_email) { %><span><%- icon('shield', 13) %> <%= t('topbar.texto', 'Pagos protegidos con Mercado Pago y PayPal') %></span><% } %></div>
</div></div>
<% } %>
<header class="mh">
  <div class="mh-top"><div class="container mh-top-in">
    <a class="brand mh-brand" href="/"><% if (settings.logo_white) { %><img class="logo" src="/media/<%= settings.logo_white %>" alt="<%= settings.site_name %>"><% } else if (settings.logo_color) { %><span class="mh-logo-chip"><img class="logo" src="/media/<%= settings.logo_color %>" alt="<%= settings.site_name %>"></span><% } else { %><span class="brand-mark mh-mark"><%= String(settings.site_name).charAt(0) %></span><span><%= settings.site_name %></span><% } %></a>
    <form class="mh-search" action="/explorar" role="search">
      <input type="search" name="q" value="<%= path === '/explorar' ? (query.q || '') : '' %>" placeholder="<%= t('nav.buscador', 'Busca ayuda, trabajos o servicios… ej.: pasear perro, flyer, mudanza') %>" aria-label="Buscar">
      <button aria-label="Buscar"><%- icon('search', 18) %></button>
    </form>
    <div class="mh-actions">
      <% if (user) { %>
        <a href="/notificaciones" class="mh-icon" aria-label="Notificaciones"><%- icon('bell', 20) %><% if (unread) { %><span class="dot"><%= unread %></span><% } %></a>
        <details class="usermenu">
          <summary class="mh-user"><span class="avatar sm"><%= user.name.charAt(0) %></span><span class="mh-hide"><%= user.name.split(' ')[0] %></span><%- icon('chevron', 14) %></summary>
          <div class="usermenu-list">
            <strong><%= user.name %></strong>
            <a href="/panel">Mi panel</a>
            <a href="/pedidos">Mis trabajos</a>
            <a href="/mensajes">Mensajes</a>
            <a href="/billetera">Billetera</a>
            <a href="/postulaciones">Mis ofertas</a>
            <a href="/servicios/nuevo">Publicar servicio</a>
            <a href="/perfil/<%= user.id %>">Mi perfil público</a>
            <a href="/planes">Planes</a>
            <a href="/cuenta">Mi cuenta</a>
            <a href="/soporte">Soporte y ayuda</a>
            <% if (impersonating) { %><form method="post" action="/volver-admin"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike"><strong>Volver a mi cuenta de administrador</strong></button></form><% } %>
            <% if (user.role === 'admin') { %><a href="/admin">Administración</a><% } %>
            <form method="post" action="/salir"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linklike">Cerrar sesión</button></form>
          </div>
        </details>
      <% } else { %>
        <a class="mh-link mh-hide" href="/registro"><%= t('nav.registro', 'Crea tu cuenta') %></a>
        <a class="mh-link" href="/ingresar"><%= t('nav.ingresar', 'Ingresa') %></a>
      <% } %>
      <a class="mh-publish" href="/tareas/nueva"><%- icon('plus', 16) %> <span><%= t('nav.publicar', 'Publicar') %></span></a>
    </div>
  </div></div>
  <div class="mh-bar"><div class="container mh-bar-in">
    <details class="mh-drop mh-city">
      <summary><%- icon('mappin', 16) %><span><small>Tu ciudad</small><b><%= city || 'Elegir ciudad' %></b></span></summary>
      <div class="mh-panel mh-cities">
        <a href="/ciudad?c=&volver=<%= encodeURIComponent(path) %>" class="<%= !city ? 'on' : '' %>">Todas las ciudades</a>
        <% CITIES.forEach(function(c){ %><a href="/ciudad?c=<%= encodeURIComponent(c) %>&volver=<%= encodeURIComponent(path) %>" class="<%= city===c ? 'on' : '' %>"><%= c %></a><% }) %>
      </div>
    </details>
    <details class="mh-drop">
      <summary><%- icon('grid', 16) %> <b>Categorías</b> <%- icon('chevron', 14) %></summary>
      <div class="mh-panel mh-mega">
        <div><h5>En persona</h5><% navCats.filter(c => c.grp === 'presencial').forEach(function(c){ %><a href="/explorar?cat=<%= c.slug %>"><%- catIcon(c.slug, 15) %> <%= c.name %></a><% }) %></div>
        <div><h5>Digital</h5><% navCats.filter(c => c.grp !== 'presencial').forEach(function(c){ %><a href="/explorar?cat=<%= c.slug %>"><%- catIcon(c.slug, 15) %> <%= c.name %></a><% }) %></div>
      </div>
    </details>
    <nav class="mh-links">
      <a href="/explorar?modalidad=presencial" class="<%= query.modalidad==='presencial' ? 'on' : '' %>"><%= t('nav.persona', 'Ayuda en persona') %></a>
      <a href="/explorar?modalidad=digital" class="<%= query.modalidad==='digital' ? 'on' : '' %>"><%= t('nav.digital', 'Trabajos digitales') %></a>
      <a href="/explorar?precio=hourly" class="<%= query.precio==='hourly' ? 'on' : '' %>"><%= t('nav.horas', 'Por horas') %></a>
      <a href="/explorar?precio=open" class="<%= query.precio==='open' ? 'on' : '' %>"><%= t('nav.problema', 'Resuelve mi problema') %></a>
      <a href="/servicios" class="<%= path.startsWith('/servicios') ? 'on' : '' %>"><%= t('nav.servicios', 'Servicios') %></a>
      <a href="/profesionales" class="<%= path.startsWith('/profesionales') ? 'on' : '' %>"><%= t('nav.profesionales', 'Ayudantes') %></a>
      <a href="/explorar?express=1" class="mh-express"><%- icon('bolt', 14) %> <%= t('nav.express', 'Express') %></a>
    </nav>
  </div></div>
</header>
<main>
<% if (flash) { %>
  <div class="container"><div class="alert alert-<%= flash.type %>"><%= flash.text %></div></div>
<% } %>
