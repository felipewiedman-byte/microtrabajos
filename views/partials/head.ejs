<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<% const isShopTitle = layout === 'shop'; const full = layout === 'shop' ? title : (title ? title + ' · ' + settings.site_name : settings.site_name + ' — ' + settings.site_tagline); %>
<title><%= (!isShopTitle && !title && settings.seo_title) ? settings.seo_title : full %></title>
<% const isShop = layout === 'shop';
   const seoDesc = String(desc || settings.site_tagline || '').replace(/\s+/g, ' ').trim().slice(0, 300);
   const seoKw = locals.keywords || (isShop ? '' : settings.seo_keywords);
   const seoImg = (og && og.image) || (!isShop && settings.seo_image ? baseUrl + '/m/' + settings.seo_image : '');
   const seoUrl = (og && og.url) || (baseUrl + (locals.reqPath || '/'));
   const shareTitle = (!isShop && !title && settings.seo_title) ? settings.seo_title : full; %>
<meta name="description" content="<%= seoDesc %>">
<% if (seoKw) { %><meta name="keywords" content="<%= seoKw %>"><% } %>
<% if (noindex) { %><meta name="robots" content="noindex,nofollow"><% } else { %><meta name="robots" content="index,follow,max-image-preview:large"><link rel="canonical" href="<%= seoUrl %>"><% } %>
<% if (!isShop && settings.google_verify) { %><meta name="google-site-verification" content="<%= settings.google_verify %>"><% } %>
<% if (!isShop && settings.bing_verify) { %><meta name="msvalidate.01" content="<%= settings.bing_verify %>"><% } %>
<meta name="theme-color" content="<%= isShop && shop ? shop.color : settings.brand_color %>">
<meta property="og:locale" content="es_LA">
<meta property="og:site_name" content="<%= isShop && shop ? shop.name : settings.site_name %>">
<meta property="og:type" content="<%= og && og.type || 'website' %>">
<meta property="og:title" content="<%= shareTitle %>">
<meta property="og:description" content="<%= seoDesc %>">
<meta property="og:url" content="<%= seoUrl %>">
<% if (seoImg) { %><meta property="og:image" content="<%= seoImg %>"><meta property="og:image:alt" content="<%= isShop && shop ? shop.name : settings.site_name %>"><% if (/\.jpg$/.test(seoImg)) { %><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:type" content="image/jpeg"><% } %><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="<%= seoImg %>"><% } else { %><meta name="twitter:card" content="summary"><% } %>
<meta name="twitter:title" content="<%= shareTitle %>"><meta name="twitter:description" content="<%= seoDesc %>">
<% if (locals.jsonld) { %><script type="application/ld+json"><%- JSON.stringify(locals.jsonld).replace(/</g, '\\u003c') %></script><% } %>
<% if (settings.favicon) { %><link rel="icon" href="/m/<%= settings.favicon %>"><% } else { %><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%230f766e'/%3E%3Cpath d='M8 12l1.3-4h13.4L24 12M8 12a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0M9 24v-9M23 24v-9M7 24h18' fill='none' stroke='white' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"><% } %>
<link rel="preload" href="/static/fonts/inter.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/css/app.css?v=<%= assetV %>">
<% if (layout === 'shop') { %><link rel="stylesheet" href="/static/css/shop.css?v=<%= assetV %>"><% } else { %><style>:root{--brand:<%= settings.brand_color %>;--brand-ink:<%= S.inkOn(settings.brand_color) %>;--brand-soft:color-mix(in srgb,<%= settings.brand_color %> 12%,#fff)}</style><% } %>
</head>
<body class="<%= layout === 'shop' ? 'shop' : (layout === 'panel' || layout === 'admin' ? 'app' : '') %>"<% if (layout === 'shop' && shop) { %> style="--brand:<%= shop.color %>;--brand-ink:<%= S.inkOn(shop.color) %>;--brand-soft:color-mix(in srgb,<%= shop.color %> 16%,var(--card))"<% } %>>
<% if (layout === 'site') { %>
<header class="top"><div class="wrap">
  <%- include('logo', { variant: 'light' }) %>
  <nav class="nav">
    <% BL.lines(settings.nav).forEach((l) => { const [t, u] = BL.cols(l, 2); %><a class="hide-s" href="<%= BL.safeUrl(u) %>"><%= t %></a><% }) %>
    <% if (user) { %><a class="btn btn-p btn-sm" href="<%= isStaff ? '/admin' : '/panel' %>"><%= isStaff ? 'Administrador' : 'Mi panel' %></a>
    <% } else { %><a href="/ingresar"><%= settings.nav_login_label %></a><a class="btn btn-p btn-sm" href="<%= BL.safeUrl(settings.nav_cta_url) %>"><%= settings.nav_cta_label %></a><% } %>
  </nav>
</div></header>
<% } else if (layout === 'panel' || layout === 'admin') { %>
<header class="top<%= layout === 'admin' ? ' admin' : '' %>"><div class="wrap" style="max-width:1180px">
  <%- include('logo', { variant: layout === 'admin' ? 'dark' : 'light', href: layout === 'admin' ? '/admin' : '/panel' }) %><% if (layout === 'admin') { %><span class="admin-tag">Administración</span><% } else if (shop) { %><span class="muted small hide-s">Panel de <b><%= shop.name %></b></span><% } %>
  <nav class="nav">
    <% if (layout === 'panel' && shop) { %><a class="btn btn-sm" href="/t/<%= shop.slug %>" target="_blank" rel="noopener"><%- icon('eye', 16) %> <span class="hide-s">Ver mi catálogo</span></a><% } %>
    <form method="post" action="/salir" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-g btn-sm" title="Salir"><%- icon('logout', 16) %> <span class="hide-s">Salir</span></button></form>
  </nav>
</div></header>
<div class="shell">
  <nav class="side" id="sideMenu" aria-label="Menú">
  <% if (layout === 'panel') { %>
    <a href="/panel" class="<%= tab === 'resumen' ? 'on' : '' %>"><%- icon('home', 18) %> Resumen</a>
    <a href="/panel/pedidos" class="<%= tab === 'pedidos' ? 'on' : '' %>"><%- icon('receipt', 18) %> Pedidos<% if (typeof newOrders !== 'undefined' && newOrders) { %><span class="cnt"><%= newOrders %></span><% } %></a>
    <a href="/panel/productos" class="<%= tab === 'productos' ? 'on' : '' %>"><%- icon('box', 18) %> <%= shop && shop.kind === 'servicios' ? 'Servicios' : 'Productos' %></a>
    <a href="/panel/cupones" class="<%= tab === 'cupones' ? 'on' : '' %>"><%- icon('percent', 18) %> Cupones</a>
    <a href="/panel/clientes" class="<%= tab === 'clientes' ? 'on' : '' %>"><%- icon('users', 18) %> Clientes</a>
    <a href="/panel/compartir" class="<%= tab === 'compartir' ? 'on' : '' %>"><%- icon('share', 18) %> Compartir</a>
    <hr>
    <a href="/panel/negocio" class="<%= tab === 'negocio' ? 'on' : '' %>"><%- icon('store', 18) %> Mi negocio</a>
    <% if (settings.mp_enabled === '1') { %><a href="/panel/pagos" class="<%= tab === 'pagos' ? 'on' : '' %>"><%- icon('shield', 18) %> Cobro en línea</a><% } %>
    <a href="/panel/plan" class="<%= tab === 'plan' ? 'on' : '' %>"><%- icon('card', 18) %> Mi plan</a>
    <a href="/panel/cuenta" class="<%= tab === 'cuenta' ? 'on' : '' %>"><%- icon('user', 18) %> Cuenta</a>
  <% } else { %>
    <% const grp = { paginas: 'sitio', textos: 'sitio', marca: 'sitio', seo: 'sitio', planes: 'planes', pagos: 'planes' }[tab] || tab; %>
    <a href="/admin" class="<%= grp === 'resumen' ? 'on' : '' %>"><%- icon('chart', 18) %> Tablero</a>
    <a href="/admin/paginas" class="<%= grp === 'sitio' ? 'on' : '' %>"><%- icon('image', 18) %> Sitio web</a>
    <a href="/admin/planes" class="<%= grp === 'planes' ? 'on' : '' %>"><%- icon('card', 18) %> Planes y cobros</a>
    <a href="/admin/usuarios" class="<%= grp === 'usuarios' ? 'on' : '' %>"><%- icon('users', 18) %> Negocios</a>
    <a href="/admin/administradores" class="<%= grp === 'equipo' ? 'on' : '' %>"><%- icon('lock', 18) %> Administradores</a>
    <a href="/admin/ajustes" class="<%= grp === 'ajustes' ? 'on' : '' %>"><%- icon('sliders', 18) %> Ajustes</a>
    <hr><a href="/panel/cuenta" class="<%= tab === 'cuenta' ? 'on' : '' %>"><%- icon('user', 18) %> Mi cuenta</a>
  <% } %>
  </nav>
  <%# Celular: barra de pestañas fija abajo, como una app. "Más" abre el menú completo. %>
  <% const T = layout === 'panel'
    ? [['/panel', 'home', 'Inicio', tab === 'resumen'], ['/panel/pedidos', 'receipt', 'Pedidos', tab === 'pedidos'], ['/panel/productos', 'box', shop && shop.kind === 'servicios' ? 'Servicios' : 'Productos', tab === 'productos'], ['/panel/compartir', 'share', 'Compartir', tab === 'compartir']]
    : [['/admin', 'chart', 'Tablero', tab === 'resumen'], ['/admin/paginas', 'image', 'Sitio', ['paginas', 'textos', 'marca', 'seo'].includes(tab)], ['/admin/planes', 'card', 'Planes', ['planes', 'pagos'].includes(tab)], ['/admin/usuarios', 'users', 'Negocios', tab === 'usuarios']]; %>
  <nav class="tabbar" aria-label="Menú principal">
    <% T.forEach((t) => { %><a href="<%= t[0] %>" class="<%= t[3] ? 'on' : '' %>"><%- icon(t[1], 21) %><span><%= t[2] %></span><% if (t[0] === '/panel/pedidos' && typeof newOrders !== 'undefined' && newOrders) { %><em><%= newOrders %></em><% } %></a><% }) %>
    <button type="button" id="moreBtn" class="<%= T.some((t) => t[3]) ? '' : 'on' %>" aria-expanded="false" aria-controls="sideMenu"><%- icon('menu', 21) %><span>Más</span></button>
  </nav>
  <div class="side-ov" id="sideOv"></div>
  <main>
  <% if (flash) { %><div class="flash <%= flash.type %>" role="status"><%= flash.text %></div><% } %>
  <% if (layout === 'panel' && user && user.role === 'owner') { %>
    <% if (plan === 'free') { %><div class="flash error"><%= TX('banner_free') %> <a href="/panel/plan"><b><%= TX('banner_link') %></b></a></div>
    <% } else if (plan === 'trial') { %><div class="flash ok"><%= TX('banner_trial', { restantes: trialLeft + ' día' + (trialLeft === 1 ? '' : 's') }) %> <a href="/panel/plan"><b><%= TX('banner_link') %></b></a></div><% } %>
  <% } %>
<% } else { %>
<main>
<% } %>
