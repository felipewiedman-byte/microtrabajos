<% const lg = variant === 'dark' ? (settings.logo_dark || settings.logo_light) : (settings.logo_light || settings.logo_dark); %><a class="logo<%= typeof cls !== 'undefined' && cls ? ' ' + cls : '' %>" href="<%= typeof href !== 'undefined' ? href : '/' %>"><% if (lg) { %><img src="/m/<%= lg %>" alt="<%= settings.site_name %>" style="height:34px;width:auto;max-width:200px"><% } else { %><b><%- icon('store', 18) %></b><%= settings.site_name %><% } %></a>
