<% if (layout === 'panel' || layout === 'admin') { %>
  </main>
</div>
<% } else { %>
</main>
<% } %>
<% if (layout === 'site') { %>
<footer class="foot"><div class="wrap">
  <div class="fcol" style="max-width:340px"><%- include('logo', { variant: 'light' }) %><p class="small mt"><%= settings.footer_text %></p></div>
  <% const cols = {}; BL.lines(settings.footer_links).forEach((l) => { const [c, t, u] = BL.cols(l, 3); (cols[c] = cols[c] || []).push([t, u]); }); Object.keys(cols).forEach((c) => { %>
  <div class="fcol"><h4><%= c %></h4><% cols[c].forEach((x) => { %><a href="<%= BL.safeUrl(x[1]) %>"><%= x[0] %></a><% }) %></div>
  <% }) %>
</div><div class="wrap foot-b"><span>© <%= new Date().getFullYear() %> <%= settings.site_name %></span></div></footer>
<% } %>
<script src="/static/js/app.js?v=<%= assetV %>" defer></script>
<% if (layout === 'shop') { %><script src="/static/js/shop.js?v=<%= assetV %>" defer></script><% } %>
</body></html>
