<div class="card" id="preguntas">
  <div class="card-head"><h3><%- icon('question', 16) %> Preguntas y respuestas</h3><span class="muted small"><%= questions.length %></span></div>
  <div class="notice-bar"><%- icon('shield', 16) %><span>Las preguntas son públicas. No se permiten teléfonos, correos, enlaces ni redes sociales: esos mensajes no se envían.</span></div>
  <% if (user && user.id !== ownerId) { %>
    <form method="post" action="/preguntas" class="row" style="flex-wrap:nowrap"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="type" value="<%= qtype %>"><input type="hidden" name="id" value="<%= qid %>">
      <input type="text" name="text" maxlength="600" placeholder="Escribe tu pregunta" required><button class="btn btn-primary">Preguntar</button></form>
  <% } else if (!user) { %><p class="small"><a href="/ingresar?next=<%= path %>"><u>Ingresa</u></a> para preguntar.</p><% } %>
  <% if (!questions.length) { %><p class="muted small mt">Aún no hay preguntas.</p><% } %>
  <% questions.forEach(function(q){ %>
    <div class="qa">
      <div class="q"><span class="tag">P</span><span><%= q.text %> <span class="muted small">· <%= publicName(q.asker) %> · <%= ago(q.created_at) %></span></span></div>
      <% if (q.answer) { %><div class="a"><span class="tag">R</span><span><%= q.answer %></span></div><% } %>
      <% if (q.order_id) { %><div class="offer"><span><strong>Oferta personalizada</strong> para <%= publicName(q.asker) %></span>
        <% if (user && user.id === q.asker_id && q.order_status === 'pending_payment') { %><a class="btn btn-accent btn-sm" href="/pedidos/<%= q.order_id %>">Ver y pagar</a><% } else { %><%- badge(q.order_status) %><% } %></div><% } %>
      <% if (user && user.id === ownerId) { %>
        <details class="mt-s" style="margin-left:22px" <%= q.answer ? '' : 'open' %>><summary class="small muted"><%= q.answer ? 'Editar respuesta' : 'Responder' %></summary>
          <form method="post" action="/preguntas/<%= q.id %>/responder" class="stack mt-s"><input type="hidden" name="_csrf" value="<%= csrf %>">
            <textarea name="answer" style="min-height:60px" required><%= q.answer || '' %></textarea>
            <% if (qtype === 'gig' && !q.order_id) { %><div class="form-row"><input type="number" name="offer_price" step="0.5" min="<%= settings.min_task_cents/100 %>" placeholder="Oferta USD (opcional)"><input type="number" name="offer_hours" min="1" max="720" placeholder="Horas de entrega"></div><p class="hint">Si indicas un precio, el cliente recibe una oferta personalizada para pagar con un clic.</p><% } %>
            <button class="btn btn-sm btn-primary">Publicar respuesta</button></form></details>
      <% } %>
    </div>
  <% }) %>
</div>
