<a class="tk" href="/tareas/<%= t.id %>">
  <div class="tk-top"><span class="tk-cat"><%- catIcon(t.cat_slug, 13) %><span><%= t.cat_name %></span></span><% if (t.express) { %><span class="tk-flag"><%- icon('bolt', 12) %> Express</span><% } else if (t.price_type === 'open') { %><span class="tk-flag tk-open">Recibe ofertas</span><% } else if (t.price_type === 'hourly') { %><span class="tk-flag tk-hour">Por horas</span><% } %></div>
  <h3 class="tk-title"><%= t.title %></h3>
  <p class="tk-desc"><%= t.description %></p>
  <ul class="tk-info">
    <% if (t.modality === 'presencial') { %><li class="tk-loc"><%- icon('mappin', 14) %> <%= t.zone %>, <%= t.city %></li><% } else { %><li><%- icon('monitor', 14) %> Remoto</li><% } %>
    <li><%- icon('clock', 14) %> <%= t.price_type === 'hourly' ? t.hours + ' h' : hours(t.delivery_hours) %></li>
    <li><%- icon('briefcase', 14) %> <%= t.apps %> <%= t.apps === 1 ? 'oferta' : 'ofertas' %></li>
  </ul>
  <div class="tk-foot">
    <div class="tk-price"><strong><%= priceMain(t.budget_cents) %> <em><%= priceCur() %></em></strong><small><%= t.price_type === 'hourly' ? priceMain(Math.round(t.budget_cents / Math.max(1, t.hours))) + ' por hora' : t.price_type === 'open' ? 'Presupuesto máximo' : t.mode === 'units' ? 'Por unidad · ' + priceSub(t.budget_cents) : priceSub(t.budget_cents) %></small></div>
    <span class="tk-btn"><%= t.price_type === 'open' ? 'Ofertar' : 'Ver tarea' %> <%- icon('arrow', 14) %></span>
  </div>
</a>
