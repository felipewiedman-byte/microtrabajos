<a class="item" href="/tareas/<%= t.id %>">
  <div class="item-top"><span class="item-ico"><%- catIcon(t.cat_slug, 16) %></span><span class="item-cat"><%= t.cat_name %></span><% if (t.express) { %><span class="badge warn">Express</span><% } else if (t.featured_until > Date.now()) { %><span class="badge accent">Destacada</span><% } %></div>
  <h3 class="item-title"><%= t.title %></h3>
  <div class="item-meta"><span><%- icon('clock', 13) %> <%= hours(t.delivery_hours) %></span><span><%- icon('users', 13) %> <%= t.mode === 'units' ? `${t.quantity - t.filled}/${t.quantity} unid.` : '1 persona' %></span><span><%- icon('briefcase', 13) %> <%= t.apps %></span></div>
  <div class="item-foot"><div><span class="item-price"><%= money(t.budget_cents) %></span><span class="item-local"><%= t.mode === 'units' ? 'por unidad · ' : '' %><%= local(t.budget_cents) %></span></div><span class="item-cta">Ver tarea</span></div>
</a>
