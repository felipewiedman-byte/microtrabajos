<a class="tk" href="/tareas/<%= t.id %>">
  <div class="tk-top"><span class="tk-cat"><%- catIcon(t.cat_slug, 13) %><span><%= t.cat_name %></span></span><% if (t.express) { %><span class="tk-flag"><%- icon('bolt', 12) %> Express</span><% } %></div>
  <h3 class="tk-title"><%= t.title %></h3>
  <p class="tk-desc"><%= t.description %></p>
  <ul class="tk-info">
    <li><%- icon('clock', 14) %> <%= hours(t.delivery_hours) %></li>
    <li><%- icon('users', 14) %> <%= t.mode === 'units' ? `${t.quantity - t.filled}/${t.quantity} unid.` : '1 persona' %></li>
    <li><%- icon('briefcase', 14) %> <%= t.apps %> <%= t.apps === 1 ? 'propuesta' : 'propuestas' %></li>
  </ul>
  <div class="tk-foot">
    <div class="tk-price"><strong><%= money(t.budget_cents).replace(' USD', '') %> <em>USD<%= t.mode === 'units' ? ' / unidad' : '' %></em></strong><small><%= local(t.budget_cents) %></small></div>
    <span class="tk-btn">Ver tarea <%- icon('arrow', 14) %></span>
  </div>
</a>
