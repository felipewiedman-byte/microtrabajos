<a class="task" href="/tareas/<%= t.id %>">
  <div class="row between"><span class="kind kind-task">Tarea · <%= t.cat_name %></span>
    <span class="row" style="gap:4px"><% if (t.featured_until > Date.now()) { %><span class="badge accent">Destacada</span><% } %><% if (t.express) { %><span class="badge warn"><%- icon('bolt', 12) %> Express</span><% } %></span></div>
  <h3><%= t.title %></h3>
  <div class="meta"><span><%- icon('clock', 13) %> <%= hours(t.delivery_hours) %></span><span><%- icon('users', 13) %> <%= t.mode === 'units' ? `${t.quantity - t.filled}/${t.quantity} unidades` : 'Una persona' %></span><span><%- icon('briefcase', 13) %> <%= t.apps %> postulaciones</span></div>
  <div class="foot"><span class="price"><%= money(t.budget_cents) %><% if (t.mode === 'units') { %><small class="muted"> /unidad</small><% } %><span class="local"><%= local(t.budget_cents) %></span></span><span class="muted small"><%= ago(t.created_at) %></span></div>
</a>
