<a class="task <%= t.featured_until > Date.now() ? 'featured' : '' %>" href="/tareas/<%= t.id %>">
  <div class="row between">
    <span class="badge"><%= t.cat_name %></span>
    <span class="row" style="gap:6px">
      <% if (t.featured_until > Date.now()) { %><span class="badge accent">Destacada</span><% } %>
      <% if (t.express) { %><span class="badge warn">Express</span><% } %>
    </span>
  </div>
  <h3><%= t.title %></h3>
  <div class="meta">
    <span>Entrega: <%= hours(t.delivery_hours) %></span><span>·</span>
    <span><%= t.mode === 'units' ? `${t.quantity - t.filled} de ${t.quantity} unidades` : 'Una persona' %></span><span>·</span>
    <span><%= t.apps %> postulaciones</span>
  </div>
  <div class="foot">
    <span class="price"><%= money(t.budget_cents) %><% if (t.mode === 'units') { %><small class="muted"> /unidad</small><% } %></span>
    <span class="muted small"><%= ago(t.created_at) %></span>
  </div>
</a>
