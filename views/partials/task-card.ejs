<a class="item2" href="/tareas/<%= t.id %>">
  <div class="i2-head"><%- catIcon(t.cat_slug, 15) %><span><%= t.cat_name %></span><% if (t.express) { %><b class="i2-flag">Express</b><% } %></div>
  <div class="i2-body">
    <h3 class="i2-title"><%= t.title %></h3>
    <div class="i2-boxes">
      <div class="i2-price"><small><%= t.mode === 'units' ? 'Precio por unidad' : 'Precio' %></small><strong><%= money(t.budget_cents) %></strong><span><%= local(t.budget_cents) %></span></div>
      <div class="i2-time"><small>Entrega</small><strong><%- icon('clock', 16) %> <%= hours(t.delivery_hours) %></strong><span><%= t.mode === 'units' ? `${t.quantity - t.filled} de ${t.quantity} unidades` : '1 persona' %></span></div>
    </div>
    <div class="i2-foot"><span><%- icon('briefcase', 13) %> <%= t.apps %> postulaciones</span><span class="i2-btn">Ver tarea</span></div>
  </div>
</a>
